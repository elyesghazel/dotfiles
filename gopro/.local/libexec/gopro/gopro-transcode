#!/usr/bin/env bash
# gopro transcode — batch-transcode fat GoPro originals into small, streamable copies.
# GPU decode + NVENC encode on Nvidia. Originals are NEVER touched; output mirrors
# the source tree, and each output is stamped with the encode profile so re-running
# after a ladder change redoes exactly the stale ones.
#
# For the normal "bring the server up to date" job use `gopro backfill` — it works
# the archive/server diff out for you. This is the lower-level tool: point it at an
# arbitrary source and get transcoded copies out.
#
# SRC may be a local dir OR an rclone remote ("name:path"). For a remote, originals
# are pulled in batches to a temp dir, transcoded, then deleted — so you don't need
# room for all the originals at once.
#
# Usage:
#   gopro transcode <SRC|remote:path> <DST_DIR> [--res N] [--codec h264|hevc] [--batch N] [--dry-run]
#
# Examples:
#   gopro transcode /mnt/mycloud/gopro ~/gopro-stream
#   gopro transcode "mycloud:Go Pro"  ~/gopro-stream          # straight from MyCloud

set -uo pipefail

LIB="$(dirname "$(readlink -f "$0")")/_lib.sh"
# shellcheck source=_lib.sh
source "$LIB"
gopro_conf || exit 1

DRYRUN=0; BATCH=8
SRC=""; DST=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --res)     RES="$2"; shift 2;;
    --codec)   CODEC="$2"; shift 2;;
    --cq)      CQ="$2"; shift 2;;
    --batch)   BATCH="$2"; shift 2;;
    --dry-run) DRYRUN=1; shift;;
    -h|--help) sed -n '2,20p' "$0"; exit 0;;
    *) if [[ -z "$SRC" ]]; then SRC="$1"; elif [[ -z "$DST" ]]; then DST="$1"; fi; shift;;
  esac
done

[[ -z "$SRC" || -z "$DST" ]] && { echo "usage: gopro transcode <SRC|remote:path> <DST_DIR> [--res N] [--codec h264|hevc] [--batch N] [--dry-run]"; exit 1; }
command -v ffmpeg >/dev/null || { echo "ffmpeg not installed"; exit 1; }
# re-resolve the encoder in case --codec overrode the config
case "$CODEC" in h264) ENC=h264_nvenc;; hevc) ENC=hevc_nvenc;; *) echo "codec must be h264 or hevc"; exit 1;; esac

# SRC is a local dir, or an rclone remote if it looks like "name:path".
REMOTE=0
if [[ "$SRC" == *:* ]]; then
  REMOTE=1
  command -v rclone >/dev/null || { echo "rclone not installed (needed for a remote source)"; exit 1; }
else
  [[ -d "$SRC" ]] || { echo "SRC not found: $SRC"; exit 1; }
fi

mkdir -p "$DST"
done_=0; skipped=0; failed=0; saved_in=0; saved_out=0

# Build the clip list as paths relative to SRC (local find, or remote rclone lsf).
if [[ $REMOTE -eq 1 ]]; then
  mapfile -t RELS < <(gopro_rclone_fast lsf -R --files-only "$SRC" | grep -iE '\.(mp4|mov)$' | sort)
  TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
else
  RELS=()
  while IFS= read -r -d '' f; do RELS+=("${f#"$SRC"/}"); done \
    < <(find "$SRC" -type f \( -iname '*.mp4' -o -iname '*.mov' \) -print0)
fi
total=${#RELS[@]}
echo ">> $total source clips found under $SRC"
echo ">> profile=$(gopro_profile)  encoder=$ENC  output=$DST"
echo

# Drop the ones already at the current profile before pulling anything.
TODO=()
for rel in "${RELS[@]}"; do
  out="$DST/${rel%.*}.mp4"
  if gopro_needs_encode "$out"; then TODO+=("$rel"); else
    skipped=$((skipped+1)); echo "skip  (current)  $rel"
  fi
done
[[ ${#TODO[@]} -eq 0 ]] && { echo; echo "== nothing stale: $skipped already at $(gopro_profile) =="; exit 0; }

if [[ $DRYRUN -eq 1 ]]; then
  printf 'enc   %s\n' "${TODO[@]}"
  echo; echo "(dry run — $((${#TODO[@]})) would be encoded, $skipped skipped)"
  exit 0
fi

encode_one() {
  local rel="$1" in="$2"
  local out="$DST/${rel%.*}.mp4"
  mkdir -p "$(dirname "$out")"
  local insize; insize=$(stat -c%s "$in")
  printf 'enc   %s  (%s)\n' "$rel" "$(numfmt --to=iec "$insize")"
  if gopro_encode "$in" "$out"; then
    local outsize; outsize=$(stat -c%s "$out")
    saved_in=$((saved_in+insize)); saved_out=$((saved_out+outsize)); done_=$((done_+1))
    printf '      -> %s  (%s, %d%% of original)\n' \
      "$(basename "$out")" "$(numfmt --to=iec "$outsize")" $(( outsize*100/insize ))
  else
    echo "      !! FAILED, removing partial output"; rm -f "$out"; failed=$((failed+1))
  fi
}

if [[ $REMOTE -eq 1 ]]; then
  # Batch the pulls: rclone only reaches full throughput with several transfers in
  # flight, and MyCloud throttles per connection.
  for ((i=0; i<${#TODO[@]}; i+=BATCH)); do
    chunk=("${TODO[@]:i:BATCH}")
    printf '\npull  %d file(s) [%d-%d of %d]\n' "${#chunk[@]}" "$((i+1))" "$((i+${#chunk[@]}))" "${#TODO[@]}"
    printf '%s\n' "${chunk[@]}" > "$TMP/files.txt"
    rm -rf "$TMP/in"; mkdir -p "$TMP/in"
    if ! gopro_rclone_fast copy --files-from "$TMP/files.txt" --progress "$SRC" "$TMP/in"; then
      echo "      !! batch download failed"; failed=$((failed+${#chunk[@]})); continue
    fi
    for rel in "${chunk[@]}"; do
      [[ -s "$TMP/in/$rel" ]] || { echo "      !! missing after pull: $rel"; failed=$((failed+1)); continue; }
      encode_one "$rel" "$TMP/in/$rel"
      rm -f "$TMP/in/$rel"
    done
  done
else
  for rel in "${TODO[@]}"; do encode_one "$rel" "$SRC/$rel"; done
fi

echo
echo "== done: $done_ transcoded, $skipped skipped, $failed failed, of $total =="
if [[ $saved_in -gt 0 ]]; then
  echo "   originals: $(numfmt --to=iec "$saved_in")  ->  streamable: $(numfmt --to=iec "$saved_out")"
fi
