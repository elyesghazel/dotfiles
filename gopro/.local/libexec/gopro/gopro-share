#!/usr/bin/env bash
# gopro-share — hand someone one clip or a whole set of them via a private link.
#
# Builds a *collection*: every clip you name goes into one token dir on the server
# and the recipient gets a dashboard at https://share.elyesghazel.ch/<token>/ —
# thumbnails, in-browser playback, and per-clip download buttons. No account, no
# login; the whole thing deletes itself when the link expires (default 14 days).
#
# Each clip gets a quality picker: the stream copy (1440p) and the full original
# (4K), so the recipient chooses. Stream copies are hard-linked from the media dir
# and cost no disk; originals are real copies, staged by the *server* pulling them
# from the archive directly (~80 MB/s), so it's seconds per clip rather than a round
# trip through this machine. Originals are staged by default -- pass --no-4k to skip
# them for a big share, or set SHARE_4K=0 in gopro.conf to flip the default.
#
# Usage:
#   gopro-share <name|pattern> [...] [--all] [--no-4k] [--days N] [--title T]
#
# Examples:
#   gopro-share GX010598                      # one clip, stream + original
#   gopro-share GX010598 GX010942 wheelie     # one link, three clips
#   gopro-share 2026-07-25 --all              # everything from that shoot
#   gopro-share 2026-07-25 --all --no-4k      # …stream copies only, instant
#   gopro-share wheelie --days 3              # link dies after 3 days
set -euo pipefail

LIB="$(dirname "$(readlink -f "$0")")/_lib.sh"
# shellcheck source=_lib.sh
source "$LIB"
gopro_conf || exit 1
: "${VPS_TARGET:?set VPS_TARGET in gopro.conf}"

SHARE_HOST="${SHARE_HOST:-share.elyesghazel.ch}"
SHARE_DIR="${SHARE_DIR:-/srv/media/gopro-share}"
SERVER_BIN="${SHARE_SERVER_BIN:-/opt/docker/gopro-share}"
DAYS="${EXPIRE_DAYS:-14}"
TITLE="${SHARE_TITLE:-GoPro}"
SSH_HOST="$(gopro_ssh_host)"; GOPRO_DIR="$(gopro_gopro_dir)"

FOURK="${SHARE_4K:-1}"; ALL=0; PATS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --all)   ALL=1; shift;;
    --4k)    FOURK=1; shift;;          # kept: it used to be the opt-in flag
    --no-4k) FOURK=0; shift;;
    --days)  DAYS="$2"; shift 2;;
    --title) TITLE="$2"; shift 2;;
    -h|--help) sed -n '2,24p' "$0"; exit 0;;
    *) PATS+=("$1"); shift;;
  esac
done
[[ ${#PATS[@]} -eq 0 ]] && { echo "usage: gopro share <name|pattern> [...] [--all] [--4k] [--days N] [--title T]"; exit 1; }

# --- resolve every pattern against the media server ---------------------------
echo ">> searching media server ..." >&2
mapfile -t CATALOG < <(ssh "$SSH_HOST" bash -s -- "$GOPRO_DIR" <<'REMOTE'
find "$1" -type f \( -iname '*.mp4' -o -iname '*.mov' \) -printf '%P\n' | sort
REMOTE
)
[[ ${#CATALOG[@]} -eq 0 ]] && { echo "no clips on the server at $GOPRO_DIR" >&2; exit 1; }

SELECTED=()
for pat in "${PATS[@]}"; do
  mapfile -t hits < <(printf '%s\n' "${CATALOG[@]}" | grep -iF "$pat" || true)
  case ${#hits[@]} in
    0) echo "no clip matching '$pat'" >&2; exit 3;;
    1) SELECTED+=("${hits[0]}");;
    *) if [[ $ALL -eq 1 ]]; then SELECTED+=("${hits[@]}"); else
         { echo "'$pat' matches ${#hits[@]} clips — narrow it, or add --all:"
           printf '   %s\n' "${hits[@]}"; } >&2
         exit 2
       fi;;
  esac
done
# de-dupe while keeping order (two patterns can hit the same clip)
mapfile -t SELECTED < <(printf '%s\n' "${SELECTED[@]}" | awk '!seen[$0]++')

echo ">> sharing ${#SELECTED[@]} clip(s):" >&2
printf '   %s\n' "${SELECTED[@]}" >&2
if [[ $FOURK -eq 1 ]]; then
  echo ">> the server will also stage the 4K originals from ${SERVER_ARCHIVE:-${ARCHIVE:-}} (--no-4k to skip)" >&2
fi

# --- ship the server-side builder, then run it --------------------------------
# rsync'd every run so the deployed copy can never drift from the dotfiles one.
SRVSRC="$(dirname "$(readlink -f "$0")")/../../../server"
if [[ -d "$SRVSRC" ]]; then
  rsync -a "$SRVSRC/gopro-share-build" "$SRVSRC/gopro-share-page.py" "$SSH_HOST:$SERVER_BIN/" \
    || echo "!! could not sync the builder — using whatever is deployed" >&2
fi

args=(--gopro "$GOPRO_DIR" --share "$SHARE_DIR" --host "$SHARE_HOST"
      --days "$DAYS" --title "$TITLE")
[[ $FOURK -eq 1 ]] && args+=(--4k --archive "${SERVER_ARCHIVE:-${ARCHIVE:-}}")

# Feed the command in over stdin rather than as ssh argv: the server's login shell
# is fish, and ssh hands it one flat string, so anything with a space (a --title, a
# clip called "luan wheelie flyby.mp4") would get re-split. printf %q quotes for
# bash, and `bash -s` is what actually reads it.
ssh "$SSH_HOST" bash -s <<EOF
exec $(printf '%q ' "$SERVER_BIN/gopro-share-build" "${args[@]}" -- "${SELECTED[@]}")
EOF
