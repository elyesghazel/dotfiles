#!/usr/bin/python3
# Short links on s.elyesghazel.ch (Shlink): `short https://… [name]` shortens, Enter copies the
# short URL. Bare `short` offers the URL on the clipboard; any other text searches your links
# (Enter copies, the second row opens the target). Same name again repoints the link.
#
# Config: ~/.config/short/config.env (SHLINK_URL, SHLINK_API_KEY), same file as the `short` CLI
# on the VPS. The link list is cached for 2 min in ~/.cache/zunder-short.
# @zunder.name   Short link
# @zunder.prefix short
# @zunder.glyph  󰌹
import sys

sys.dont_write_bytecode = True

import json  # noqa: E402
import os
import re
import shlex
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CONFIG = Path.home() / ".config/short/config.env"
CACHE = Path.home() / ".cache/zunder-short/links.json"
TTL = 120
UA = "zunder-short/1.0"
URL_RE = re.compile(r"^(https?://\S+|[a-z0-9-]+(\.[a-z0-9-]+)+(/\S*)?)$", re.I)
SLUG_RE = re.compile(r"^[A-Za-z0-9_-]{1,64}$")


def emit(title, subtitle="", hint="", glyph=None, action=None):
    line = {"title": title, "subtitle": subtitle, "hint": hint}
    if glyph:
        line["glyph"] = glyph
    if action:
        line["action"] = action
    print(json.dumps(line), flush=True)


def me(*args):
    return " ".join(shlex.quote(a) for a in (sys.executable, os.path.realpath(__file__), *args))


def sh(cmd, text=None):
    try:
        subprocess.run(cmd, input=text, text=True, check=False, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def notify(title, body=""):
    sh(["notify-send", "-a", "zunder", title, body])


def config():
    cfg = {}
    if CONFIG.exists():
        for line in CONFIG.read_text().splitlines():
            if "=" in line and not line.lstrip().startswith("#"):
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip("\"'")
    cfg.setdefault("SHLINK_URL", "https://s.elyesghazel.ch")
    return cfg


def api(cfg, method, path, body=None, query=None):
    url = cfg["SHLINK_URL"].rstrip("/") + "/rest/v3" + path
    if query:
        url += "?" + urllib.parse.urlencode(query)
    req = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body else None, headers={
        "X-Api-Key": cfg["SHLINK_API_KEY"], "Accept": "application/json",
        "Content-Type": "application/json", "User-Agent": UA})
    with urllib.request.urlopen(req, timeout=10) as r:
        return json.loads(r.read() or b"{}")


def normalize(url):
    return url if re.match(r"^https?://", url, re.I) else "https://" + url


def links(cfg, fresh=False):
    if not fresh and CACHE.exists() and time.time() - CACHE.stat().st_mtime < TTL:
        return json.loads(CACHE.read_text())
    data = api(cfg, "GET", "/short-urls", query={"itemsPerPage": 500, "orderBy": "dateCreated-DESC"})
    items = [{"short": i["shortUrl"], "slug": i["shortCode"], "url": i["longUrl"], "title": i.get("title") or ""}
             for i in data.get("shortUrls", {}).get("data", [])]
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_text(json.dumps(items))
    return items


def copy(text):
    sh(["wl-copy"], text)


# ── actions (run detached by zunder) ──────────────────

def create(url, slug=""):
    cfg = config()
    body = {"longUrl": url, "findIfExists": not slug}
    if slug:
        body["customSlug"] = slug
    try:
        try:
            short = api(cfg, "POST", "/short-urls", body)["shortUrl"]
            verb = "Shortened"
        except urllib.error.HTTPError as e:
            if not slug or e.code != 400:
                raise
            # the name is taken: repoint it, like `short <url> <existing-name>`
            short = api(cfg, "PATCH", f"/short-urls/{slug}", {"longUrl": url})["shortUrl"]
            verb = "Repointed"
    except Exception as e:
        notify("Short link failed", str(e)[:200])
        return
    copy(short)
    CACHE.unlink(missing_ok=True)
    notify(f"{verb} · copied", f"{short}\n→ {url}")


# ── listing ───────────────────────────────────────────

def clipboard_url():
    try:
        r = subprocess.run(["wl-paste", "--no-newline"], capture_output=True, text=True, timeout=1)
        text = r.stdout.strip()
        return text if r.returncode == 0 and URL_RE.match(text) and len(text) < 2000 else None
    except Exception:
        return None


def offer(url, slug):
    url = normalize(url)
    base = config()["SHLINK_URL"].split("://", 1)[-1].rstrip("/")
    target = f"{base}/{slug}" if slug else f"{base}/…"
    emit(f"Shorten → {target}", url, "↵ shorten + copy", "󰌹", {"run": me("create", url, slug)})


def show_links(cfg, needle=""):
    try:
        items = links(cfg)
    except Exception as e:
        emit("Shlink not reachable", str(e)[:120], glyph="")
        return
    n = needle.lower()
    hits = [i for i in items if not n or n in f"{i['slug']} {i['url']} {i['title']}".lower()][:8]
    for i in hits:
        emit(i["short"].split("://", 1)[-1], i["title"] or i["url"], "↵ copy", "󰌹", {"copy": i["short"]})
    if hits and n:
        emit(f"Open target of {hits[0]['slug']}", hits[0]["url"], "↵ open", "󰖟", {"open": hits[0]["url"]})
    if n and not hits:
        emit(f"No link matches “{needle}”", "type a URL to shorten it", glyph="")


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "create":
        return create(*sys.argv[2:4])
    q = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
    cfg = config()
    if not cfg.get("SHLINK_API_KEY"):
        emit("short: no API key", f"put SHLINK_API_KEY in {CONFIG}", glyph="")
        return
    parts = q.split()
    if parts and URL_RE.match(parts[0]):
        slug = parts[1] if len(parts) > 1 else ""
        if slug and not SLUG_RE.match(slug):
            emit("Name can only use letters, digits, - and _", slug, glyph="")
            return
        offer(parts[0], slug)
        return
    if not q:
        clip = clipboard_url()
        if clip:
            offer(clip, "")
        else:
            emit("type or paste a URL", "short https://… [name] · or search your links", glyph="󰌹")
    show_links(cfg, q)


if __name__ == "__main__":
    main()
