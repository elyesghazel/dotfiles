#!/usr/bin/python3
# New Google Calendar event: `ev dentist tue 14:00`, `ev exam 12.10. 9-11 @ room 204`, `ev trip sat`.
# Opens Google Calendar's new-event page filled in; one click on Save. 1 hour unless a range is
# given; no time means all day. Text after @ is the location.
# @zunder.name   New Event
# @zunder.prefix ev
# @zunder.glyph  
import datetime as dt
import os
import sys

sys.dont_write_bytecode = True

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import zcal  # noqa: E402

text = sys.argv[1].strip() if len(sys.argv) > 1 else ""
if not text:
    zcal.emit("type an event", "e.g. dentist tue 14:00 · exam 12.10. 9-11 @ room 204 · trip sat", glyph="")
    sys.exit()

where = ""
if " @ " in text:
    text, _, where = text.partition(" @ ")
what, start, has_time = zcal.split_when(text)
if not start:
    zcal.emit(f"Event: {text}", "add a day or time, e.g. tue 14:00", glyph="")
    sys.exit()

span = zcal.time_range(text)
if span:
    start = start.replace(hour=span[0][0], minute=span[0][1])
    end = start.replace(hour=span[1][0], minute=span[1][1])
    if end <= start:
        end += dt.timedelta(days=1)
elif has_time:
    end = start + dt.timedelta(hours=1)
else:
    start = start.replace(hour=0, minute=0)
    end = start + dt.timedelta(days=1)

label = f"{zcal.when_label(start, has_time or bool(span))}" + (f"–{end:%H:%M}" if has_time or span else ", all day")
zcal.emit(f"Event: {what}", label + (f" · {where}" if where else ""), "↵ google calendar",
          action={"open": zcal.google_event_url(what, start, end, not (has_time or span), where)})
