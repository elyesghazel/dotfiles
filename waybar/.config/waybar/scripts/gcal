#!/usr/bin/python3
"""Google Calendar for waybar, read from each calendar's secret iCal address.

    gcal waybar    JSON for the custom/gcal module (next event + tooltip agenda)
    gcal popup     interactive agenda + Apple Reminders for a terminal: enter/click opens
                   an item's link (obsidian:// first), space/click on ○ completes a reminder
    gcal toggle    open the popup under the bar, or close it if it is open
    gcal toggle --big   same, as a large centered overlay (SUPER+K, conf/binds.lua)
    gcal lock      agenda + reminders as pango markup for hyprlock.conf
    gcal add "<title> @ <when> | <description>"   new Google Calendar event
    gcal auth      one-time Google sign-in so `a` / `gcal add` can write events

The popup has two tabs (tab / 1 / 2): the overview, and a week calendar where
arrows move through days, enter opens an item (SlidePlate ones open their vault note)
and `a` adds an event. Writing needs ~/.config/gcal/oauth.env (from `gcal auth`).

Calendars live in ~/.config/gcal/calendars (outside the repo, it holds secret URLs),
one per line:   <name>  <secret iCal address>
Google Calendar → Settings → <calendar> → "Secret address in iCal format".
"""

import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

CONF = Path(os.environ.get("GCAL_CONF", Path.home() / ".config/gcal/calendars"))
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "waybar-gcal"
TTL = 600  # seconds before an .ics is fetched again
POPUP_CLASS = "gcal-popup"
OVERLAY_CLASS = "gcal-overlay"
POPUP_W, POPUP_H = 460, 680

# Graphite palette, mirrors colors.dark.css
FG, MUTED, FAINT, FG_GHOST = "#e6e6ee", "#9a9aac", "#5a5a6a", "#34343f"
ACCENT, GREEN, YELLOW, RED = "#b4befe", "#a6e3a1", "#f9e2af", "#f38ba8"


def calendars():
    if not CONF.exists():
        return []
    out = []
    for line in CONF.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            name, _, url = line.rpartition(" ")
            out.append((name.strip() or "Calendar", url.strip()))
    return out


def fetch(url, force=False):
    CACHE.mkdir(parents=True, exist_ok=True)
    path = CACHE / (hashlib.sha1(url.encode()).hexdigest() + ".ics")
    fresh = path.exists() and dt.datetime.now().timestamp() - path.stat().st_mtime < TTL
    if force or not fresh:
        try:
            with urllib.request.urlopen(url, timeout=10) as r:
                data = r.read()
            tmp = path.with_suffix(".tmp")
            tmp.write_bytes(data)
            tmp.replace(path)
        except Exception:
            if not path.exists():
                raise
    return path.read_bytes()  # stale cache beats nothing when offline


def local(value):
    """Date or datetime → (aware local datetime, all_day)."""
    if isinstance(value, dt.datetime):
        if value.tzinfo is None:
            value = value.astimezone()
        return value.astimezone(), False
    return dt.datetime.combine(value, dt.time()).astimezone(), True


def events(days, force=False, keep_past=False, start=None):
    import icalendar
    import recurring_ical_events

    now = dt.datetime.now().astimezone()
    start = start or now.replace(hour=0, minute=0, second=0, microsecond=0)
    end = start + dt.timedelta(days=days)
    out = []
    for name, url in calendars():
        cal = icalendar.Calendar.from_ical(fetch(url, force))
        for ev in recurring_ical_events.of(cal).between(start, end):
            s, all_day = local(ev["DTSTART"].dt)
            e = local(ev["DTEND"].dt)[0] if "DTEND" in ev else s + dt.timedelta(hours=1)
            if e <= now and not all_day and not keep_past:
                continue
            desc = str(ev.get("DESCRIPTION", ""))
            out.append({
                "title": str(ev.get("SUMMARY", "(no title)")),
                "where": str(ev.get("LOCATION", "")),
                "start": s, "end": e, "all_day": all_day, "cal": name, "kind": "ev",
                "uid": str(ev.get("UID", "")), "desc": desc,
                "link": first_link(str(ev.get("URL", "")), desc),
            })
    seen = {e["uid"] for e in out}
    out += [e for e in added_events() if e["uid"] not in seen and start <= e["start"] < end]
    out.sort(key=lambda x: (x["start"], not x["all_day"]))
    return out


def day_label(d):
    today = dt.date.today()
    rel = {today: "Today", today + dt.timedelta(days=1): "Tomorrow"}.get(d)
    return f"{rel} · {d:%a %d %b}" if rel else f"{d:%A} · {d:%d %b}"


def span(ev):
    if ev["all_day"]:
        return "all day"
    return f"{ev['start']:%H:%M}–{ev['end']:%H:%M}"


def until(delta):
    """timedelta → '25m', '2h 05m', '3d'."""
    mins = max(0, int(delta.total_seconds() // 60))
    if mins < 60:
        return f"{mins}m"
    if mins < 24 * 60:
        return f"{mins // 60}h {mins % 60:02d}m"
    return f"{mins // (24 * 60)}d"


def now_next(evs, now):
    timed = [e for e in evs if not e["all_day"]]
    current = next((e for e in timed if e["start"] <= now < e["end"]), None)
    upcoming = next((e for e in timed if e["start"] > now), None)
    return current, upcoming


def esc(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def cell_width(ch):
    """Terminal columns of one character: emoji like 💻 take two, joiners none."""
    import unicodedata
    if ch in "‍️" or unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in "WF" else 1


def text_width(s):
    return sum(cell_width(c) for c in s)


def short(s, n):
    if text_width(s) <= n:
        return s
    out, w = "", 0
    for c in s:
        if w + cell_width(c) > n - 1:
            break
        out, w = out + c, w + cell_width(c)
    return out + "…"


# ── apple reminders ────────────────────────────────────
# Through pyicloud, like the `remind` fish function. A listing takes ~4s, so it is cached.

ICLOUD = Path.home() / ".local/bin/icloud"
REM_CACHE = CACHE / "reminders.json"
REM_TTL = 180
LINK = re.compile(r"(obsidian://\S+|https?://\S+)")


def icloud(*args):
    # the icloud fish wrapper keeps the session in ~/.local/state/pyicloud, not /tmp
    env = {**os.environ, "TMPDIR": str(Path.home() / ".local/state")}
    return subprocess.run([str(ICLOUD), *args, "--log-level", "error"], env=env,
                          capture_output=True, text=True, timeout=60)


def first_link(*texts):
    links = [m.group(1).rstrip(").,>") for t in texts if t for m in LINK.finditer(t)]
    return next((l for l in links if l.startswith("obsidian://")), links[0] if links else None)


def fetch_reminders():
    """Hit iCloud and refresh the cache. Raises on failure."""
    for _ in range(2):  # iCloud now and then fails once, like remind.fish retries
        r = icloud("reminders", "list", "--format", "json")
        if r.returncode == 0:
            CACHE.mkdir(parents=True, exist_ok=True)
            tmp = REM_CACHE.with_suffix(".tmp")
            tmp.write_text(r.stdout)
            tmp.replace(REM_CACHE)
            return
    raise RuntimeError((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout) else "icloud failed")


def reminders_stale():
    return not REM_CACHE.exists() or time.time() - REM_CACHE.stat().st_mtime > REM_TTL


def reminders(done=()):
    """Open reminders from the cache, soonest due first, undated last."""
    if not REM_CACHE.exists() or not ICLOUD.exists():
        return []
    out = []
    for r in json.loads(REM_CACHE.read_text()):
        if r["completed"] or r["deleted"] or r["id"] in done:
            continue
        due = dt.datetime.fromisoformat(r["due_date"]).astimezone() if r.get("due_date") else None
        out.append({
            "kind": "rem", "id": r["id"], "title": r["title"], "due": due,
            "all_day": r.get("all_day"), "priority": r.get("priority") or 0,
            "link": first_link(r["title"], r.get("desc")), "desc": r.get("desc") or "",
        })
    far = dt.datetime.max.replace(tzinfo=dt.timezone.utc)
    out.sort(key=lambda x: (x["due"] or far, x["title"].lower()))
    return out


def complete(rem_id):
    r = icloud("reminders", "set-status", rem_id, "--completed")
    if r.returncode != 0:
        raise RuntimeError("could not complete reminder")


def due_label(rem, now):
    due = rem["due"]
    if not due:
        return "", FAINT
    d = due.date()
    if d < now.date() or (not rem["all_day"] and due < now):
        color = RED
    elif d == now.date():
        color = YELLOW
    else:
        color = MUTED
    if d == now.date():
        day = "today"
    elif d == now.date() + dt.timedelta(days=1):
        day = "tmrw"
    elif abs((d - now.date()).days) < 7:
        day = f"{d:%a}"
    else:
        day = f"{d:%d %b}"
    return (day if rem["all_day"] else f"{day} {due:%H:%M}"), color


# ── writing to google calendar ─────────────────────────
# The iCal feeds above are read-only. Writes go through the Calendar API with a refresh
# token in ~/.config/gcal/oauth.env (GCAL_CLIENT_ID, GCAL_CLIENT_SECRET, GCAL_REFRESH_TOKEN,
# GCAL_REDIRECT_URI), written by `gcal auth`. The secret feed lags a few minutes behind,
# so events made here are kept in ADDED until the feed has them.

OAUTH = CONF.parent / "oauth.env"
ADDED = CACHE / "added.json"
SCOPE = "https://www.googleapis.com/auth/calendar.events"


def oauth_conf():
    conf = {}
    if OAUTH.exists():
        for line in OAUTH.read_text().splitlines():
            key, sep, value = line.partition("=")
            if sep and not key.startswith("#"):
                conf[key.strip()] = value.strip().strip('"')
    return conf


def google(method, url, body=None, form=None):
    data = json.dumps(body).encode() if body is not None else urllib.parse.urlencode(form).encode() if form else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Content-Type", "application/json" if body is not None else "application/x-www-form-urlencoded")
    if form is None:
        req.add_header("Authorization", f"Bearer {access_token()}")
    try:
        with urllib.request.urlopen(req, timeout=15) as r:
            return json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        detail = e.read().decode(errors="ignore")
        try:
            detail = json.loads(detail)["error"]
            detail = detail.get("message", detail) if isinstance(detail, dict) else detail
        except Exception:
            pass
        raise RuntimeError(f"Google {e.code}: {detail}") from None


def access_token():
    conf = oauth_conf()
    if not conf.get("GCAL_REFRESH_TOKEN"):
        raise RuntimeError("not signed in, run `gcal auth` once")
    return google("POST", "https://oauth2.googleapis.com/token", form={
        "client_id": conf["GCAL_CLIENT_ID"], "client_secret": conf["GCAL_CLIENT_SECRET"],
        "refresh_token": conf["GCAL_REFRESH_TOKEN"], "grant_type": "refresh_token"})["access_token"]


def added_events():
    if not ADDED.exists():
        return []
    out = []
    for e in json.loads(ADDED.read_text()):
        e["start"], e["end"] = dt.datetime.fromisoformat(e["start"]), dt.datetime.fromisoformat(e["end"])
        out.append(e)
    return out


def remember_added(ev):
    keep = [e for e in added_events() if e["end"] > dt.datetime.now().astimezone() - dt.timedelta(days=1)]
    keep.append(ev)
    CACHE.mkdir(parents=True, exist_ok=True)
    ADDED.write_text(json.dumps([{**e, "start": e["start"].isoformat(), "end": e["end"].isoformat()}
                                 for e in keep]))


TIME = r"\d{1,2}(?::\d{2})?"


def parse_when(when, day):
    """'tue 14:00-15:30', '14:00', 'fri', '' → (start, end, all_day); `day` fills in a bare time."""
    when = when.strip()
    m = re.fullmatch(rf"(.*?)\s*({TIME})\s*(?:-|–|bis|to)\s*({TIME})", when)
    date_part, t0, t1 = (m[1], m[2], m[3]) if m else (when, None, None)
    if not m:
        m = re.fullmatch(rf"(.*?)\s*({TIME})", when)
        if m and (":" in m[2] or not m[1] or m[1].endswith(("at", "um"))):
            date_part, t0 = re.sub(r"\s*(at|um)$", "", m[1]), m[2]

    def gnu(expr):
        r = subprocess.run(["date", "-d", expr, "+%Y-%m-%d"], capture_output=True, text=True)
        if r.returncode:
            raise ValueError(f"can't read the date '{expr}'")
        return dt.date.fromisoformat(r.stdout.strip())

    d = gnu(date_part) if date_part.strip() else day
    if not t0:
        return dt.datetime.combine(d, dt.time()).astimezone(), dt.datetime.combine(d + dt.timedelta(days=1), dt.time()).astimezone(), True
    hm = lambda t: dt.time(*map(int, (t + ":00").split(":")[:2]))
    start = dt.datetime.combine(d, hm(t0)).astimezone()
    end = dt.datetime.combine(d, hm(t1)).astimezone() if t1 else start + dt.timedelta(hours=1)
    if end <= start:
        end += dt.timedelta(days=1)
    return start, end, False


def add_event(text, day=None):
    """'Dentist @ tue 14:00 | bring the card' → created event dict. No '@' means all day on `day`."""
    text, _, desc = text.partition("|")
    title, _, when = text.partition("@")
    title = title.strip()
    if not title:
        raise ValueError("no title")
    start, end, all_day = parse_when(when, day or dt.date.today())
    body = {"summary": title, "description": desc.strip()}
    if all_day:
        body["start"], body["end"] = {"date": f"{start:%Y-%m-%d}"}, {"date": f"{end:%Y-%m-%d}"}
    else:
        body["start"], body["end"] = {"dateTime": start.isoformat()}, {"dateTime": end.isoformat()}
    made = google("POST", "https://www.googleapis.com/calendar/v3/calendars/primary/events", body=body)
    ev = {"title": title, "where": "", "start": start, "end": end, "all_day": all_day,
          "cal": "Personal", "kind": "ev", "uid": made.get("iCalUID", ""), "desc": body["description"],
          "link": first_link(body["description"])}
    remember_added(ev)
    return ev


def cmd_add():
    try:
        ev = add_event(" ".join(sys.argv[2:]))
    except Exception as e:
        sys.exit(f"gcal add: {e}")
    print(f"added: {ev['title']} · {ev['start']:%a %d %b} {span(ev)}")


def cmd_auth():
    conf = oauth_conf()
    for key, ask in (("GCAL_CLIENT_ID", "OAuth client id"), ("GCAL_CLIENT_SECRET", "client secret"),
                     ("GCAL_REDIRECT_URI", "redirect URI registered on the client")):
        conf[key] = conf.get(key) or input(f"{ask}: ").strip()
    url = "https://accounts.google.com/o/oauth2/v2/auth?" + urllib.parse.urlencode({
        "client_id": conf["GCAL_CLIENT_ID"], "redirect_uri": conf["GCAL_REDIRECT_URI"],
        "response_type": "code", "scope": SCOPE, "access_type": "offline", "prompt": "consent"})
    print(f"\nOpen this, allow access, then copy code=… out of the address bar:\n\n{url}\n")
    code = urllib.parse.unquote(input("code: ").strip().split("code=")[-1].split("&")[0])
    tok = google("POST", "https://oauth2.googleapis.com/token", form={
        "code": code, "client_id": conf["GCAL_CLIENT_ID"], "client_secret": conf["GCAL_CLIENT_SECRET"],
        "redirect_uri": conf["GCAL_REDIRECT_URI"], "grant_type": "authorization_code"})
    conf["GCAL_REFRESH_TOKEN"] = tok["refresh_token"]
    OAUTH.parent.mkdir(parents=True, exist_ok=True)
    OAUTH.touch(mode=0o600)
    OAUTH.write_text("".join(f"{k}={v}\n" for k, v in conf.items()))
    print(f"saved {OAUTH}")


# ── slideplate ─────────────────────────────────────────
# Dated video notes in the vault show up in the week view; SlidePlate events, tasks and
# notes are tinted and open their vault note (or the SlidePlate README) on enter.

VAULT = Path(os.environ.get("GCAL_VAULT", Path.home() / "projects/elyes-vault"))
SP_DIR = "02_Business/slideplate"
SP = "#fab387"


def obsidian(rel):
    return "obsidian://open?" + urllib.parse.urlencode({"vault": VAULT.name, "file": rel}, quote_via=urllib.parse.quote)


def is_sp(item):
    text = f"{item['title']} {item.get('desc', '')} {item.get('link') or ''}".lower()
    return item["kind"] == "note" or "slideplate" in text or "sp:" in text


def vault_notes():
    """Video notes with a `date:` in their frontmatter, as all-day items."""
    out = []
    for path in sorted((VAULT / SP_DIR / "videos").glob("*.md")):
        try:
            head = path.read_text(errors="ignore").split("\n---", 1)[0]
        except OSError:
            continue
        meta = dict(re.findall(r"^(\w[\w-]*):[ \t]*(.*)$", head, re.M))
        try:
            day = dt.date.fromisoformat(meta.get("date", "").strip())
        except ValueError:
            continue
        hook = re.search(r'^>\s*"?(.+?)"?\s*$', path.read_text(errors="ignore"), re.M)
        status = meta.get("status", "").strip()
        out.append({
            "kind": "note", "title": f"🎬 {meta.get('title', path.stem).strip()}", "all_day": True,
            "start": dt.datetime.combine(day, dt.time()).astimezone(), "status": status,
            "desc": "\n".join(x for x in (f"status: {status}" if status else "",
                                          f"hook: {hook[1]}" if hook else "") if x),
            "link": obsidian(str(path.relative_to(VAULT))), "where": "",
        })
    return out


def item_link(item):
    if item.get("link"):
        return item["link"]
    if is_sp(item):
        return obsidian(f"{SP_DIR}/README.md")
    return "https://calendar.google.com" if item["kind"] == "ev" else None


# ── week view ──────────────────────────────────────────

def clean(desc):
    desc = re.sub(r"<br\s*/?>|</p>", "\n", desc or "")
    return re.sub(r"<[^>]+>", "", desc).replace("&nbsp;", " ").replace("&amp;", "&").strip()


def wrap(text, width):
    import textwrap
    out = []
    for para in text.splitlines() or [""]:
        out += textwrap.wrap(para, width) or [""]
    return out


def day_items(state, d):
    """(all-day, timed) items of day `d`: events, dated reminders, vault notes."""
    now = dt.datetime.now().astimezone()
    allday, timed = [], []
    for ev in state["events"]:
        first, last = ev["start"].date(), (ev["end"] - dt.timedelta(seconds=1)).date()
        if first <= d <= last:
            (allday if ev["all_day"] or first != last else timed).append(ev)
    for rem in state["reminders"]:
        if rem["due"] and max(rem["due"].date(), now.date()) == d:
            (allday if rem["all_day"] or rem["due"].date() != d else timed).append(rem)
    allday += [n for n in state["notes"] if n["start"].date() == d]
    when = lambda i: i.get("start") or i.get("due")
    return allday, sorted(timed, key=when)


def week_items(state, monday):
    """Every item of the week in navigation order: day by day, all-day first."""
    out = []
    for n in range(7):
        a, t = day_items(state, monday + dt.timedelta(days=n))
        out += [(monday + dt.timedelta(days=n), i) for i in a + t]
    return out


def chip(item, width, now):
    """One-line label of an item inside a day column, with its colours."""
    if item["kind"] == "rem":
        due, color = due_label(item, now)
        t = "" if item["all_day"] else f"{item['due']:%H:%M} "
        return f"○ {t}{item['title']}", RED if color == RED else SP if is_sp(item) else MUTED, None
    if item["kind"] == "note":
        posted = item.get("status") == "posted"
        return item["title"], FAINT if posted else SP, None
    past = (item["end"] <= now) if not item["all_day"] else item["end"].date() <= now.date()
    color = SP if is_sp(item) else ACCENT
    return item["title"], FAINT if past else FG, None if past else color


def block_bg(hex_):
    """A dark tint of `hex_` for event blocks."""
    r, g, b = (int(hex_[i:i + 2], 16) for i in (1, 3, 5))
    return bg("#%02x%02x%02x" % tuple(int(14 + (c - 14) * 0.22) for c in (r, g, b)))


def pad_to(s, width):
    s = short(s, width)
    return s + " " * max(0, width - text_width(s))


def week_view(state, cols, height):
    """→ (lines, hits): the week grid plus a detail pane; hits are (y, x0, x1, (day, item))."""
    now = dt.datetime.now().astimezone()
    day, sel = state["cal_day"], state["cal_sel"]
    monday = day - dt.timedelta(days=day.weekday())
    detail_w = 46 if cols >= 150 else 0
    gutter = 7
    col_w = max(10, (cols - gutter - (detail_w + 3 if detail_w else 0)) // 7)
    grid_w = gutter + col_w * 7
    lines, hits = [], []

    week_no = monday.isocalendar()[1]
    span_label = (f"{monday:%d %b} – {monday + dt.timedelta(days=6):%d %b %Y}")
    title = f"  {rgb(FG, True)}{span_label}{R}  {rgb(FAINT)}week {week_no}{R}"
    lines.append(title)
    lines.append(f"  {rgb(RED)}{short(state['error'], grid_w - 4)}{R}" if state["error"] else "")

    head = " " * gutter
    for n in range(7):
        d = monday + dt.timedelta(days=n)
        label = f" {d:%a %d}"
        if d == now.date():
            cell = f"{bg(GREEN)}\033[1;38;2;14;14;20m{pad_to(label, col_w - 1)}{R} "
        elif d == day:
            cell = f"{SEL}{rgb(FG, True)}{pad_to(label, col_w - 1)}{R} "
        else:
            cell = f"{rgb(MUTED if d.weekday() < 5 else FAINT, True)}{pad_to(label, col_w)}{R}"
        head += cell
    lines.append(head)

    per_day = [day_items(state, monday + dt.timedelta(days=n)) for n in range(7)]
    rows_all = min(4, max([len(a) for a, _ in per_day] + [1]))
    for r in range(rows_all):
        line = " " * gutter
        y = len(lines)
        for n, (allday, _) in enumerate(per_day):
            d = monday + dt.timedelta(days=n)
            if r < len(allday) and (r < rows_all - 1 or len(allday) == rows_all):
                item = allday[r]
                text, fg, tint = chip(item, col_w, now)
                shade = SEL if item is sel else block_bg(tint) if tint else ""
                cell = f"{shade}{rgb(fg)} {pad_to(text, col_w - 2)}{R} "
                hits.append((y, gutter + n * col_w, gutter + (n + 1) * col_w, (d, item)))
            elif r == rows_all - 1 and len(allday) > rows_all:
                cell = f"{rgb(FAINT)}{pad_to(f' +{len(allday) - r} more', col_w)}{R}"
            else:
                cell = " " * col_w
            line += cell
        lines.append(line)
    lines.append(f"{rgb(FG_GHOST)}{'─' * grid_w}{R}")

    # hours: from the earliest item (or 07) to the latest (or 22)
    timed = [i for _, t in per_day for i in t]
    starts = [(i.get("start") or i["due"]).hour for i in timed]
    ends = [((i.get("end") or i["due"]) - dt.timedelta(minutes=1)).hour + 1 for i in timed]
    h0, h1 = min(starts + [7]), max(ends + [22])
    h1 = min(24, max(h1, h0 + 1))
    avail = height - len(lines) - 1
    rph = max(1, avail // (h1 - h0))  # rows per hour
    while (h1 - h0) * rph > avail and h1 - h0 > 6:  # too many hours: trim the quiet ends
        if h1 - 1 >= max(ends + [h0 + 1]):
            h1 -= 1
        elif h0 + 1 <= min(starts + [h1 - 1]):
            h0 += 1
        else:
            break

    while (h1 - h0 + 1) * rph <= avail and (h0 > 6 or h1 < 24):
        if h1 < 24:
            h1 += 1
        else:
            h0 -= 1

    def row_of(t):
        return (t.hour - h0) * rph + (t.minute * rph) // 60

    nrows = (h1 - h0) * rph
    grid = [[None] * 7 for _ in range(nrows)]  # each cell: list of (item, first_row?) per lane
    for n, (_, items) in enumerate(per_day):
        spans = []
        for it in items:
            s = it.get("start") or it["due"]
            e = it.get("end") or (s + dt.timedelta(minutes=30))
            r0 = max(0, min(nrows - 1, row_of(s)))
            r1 = max(r0 + 1, min(nrows, row_of(e) if e.date() == s.date() else nrows))
            spans.append((it, r0, r1))
        # clusters of blocks that overlap each other share the column in lanes
        cluster, lanes, cluster_end = [], [], -1
        for it, r0, r1 in sorted(spans, key=lambda x: x[1]) + [(None, nrows + 1, nrows + 1)]:
            if r0 >= cluster_end and cluster:
                for c_it, c0, c1, lane in cluster:
                    for r in range(c0, c1):
                        if grid[r][n] is None:
                            grid[r][n] = [None] * len(lanes)
                        grid[r][n][lane] = (c_it, r - c0, c1 - c0)
                cluster, lanes = [], []
            if it is None:
                break
            lane = next((k for k, end in enumerate(lanes) if end <= r0), None)
            if lane is None:
                lanes.append(r1)
                lane = len(lanes) - 1
            else:
                lanes[lane] = r1
            cluster.append((it, r0, r1, lane))
            cluster_end = max(cluster_end, r1) if len(cluster) > 1 else r1

    now_row = row_of(now) if h0 <= now.hour < h1 and monday <= now.date() < monday + dt.timedelta(days=7) else None
    for r in range(nrows):
        hour = h0 + r // rph
        label = f"{hour:02d}:00" if r % rph == 0 else ""
        line = f"{rgb(FAINT)}{label:>5}{R}  "
        y = len(lines)
        for n in range(7):
            d = monday + dt.timedelta(days=n)
            cell = grid[r][n]
            if not cell:
                if r == now_row and d == now.date():
                    line += f"{rgb(RED)}{'━' * (col_w - 1)}{R} "
                else:
                    dot = "·" if r % rph == 0 else " "
                    line += f"{rgb(FG_GHOST)}{dot}{R}" + " " * (col_w - 1)
                continue
            lane_w = max(3, (col_w - 1) // len(cell))
            used = 0
            for k, slot in enumerate(cell):
                w = lane_w if k < len(cell) - 1 else col_w - 1 - used
                used += w
                if slot is None:
                    line += " " * w
                    continue
                it, off, length = slot
                text, fg, tint = chip(it, w, now)
                if off == 1 and it["kind"] == "ev":
                    text, fg = (span(it) if not it["all_day"] else ""), MUTED
                elif off == 2 and it["kind"] == "ev":
                    text, fg = it["where"], FAINT
                elif off:
                    text = ""
                shade = SEL if it is sel else block_bg(tint or MUTED)
                edge = f"{rgb(tint or MUTED)}▎" if it["kind"] == "ev" else " "
                line += f"{shade}{edge}{rgb(fg, off == 0)}{pad_to(text, w - 1)}{R}"
                x0 = gutter + n * col_w + used - w
                hits.append((y, x0, x0 + w, (d, it)))
            line += " "
        lines.append(line)

    if detail_w:
        pane = detail(sel, day, state, detail_w - 2, now)
        out = []
        for y in range(max(len(lines), len(pane))):
            left = lines[y] if y < len(lines) else ""
            left += " " * max(0, grid_w - visible(left))
            right = pane[y] if y < len(pane) else ""
            out.append(f"{left} {rgb(FG_GHOST)}│{R} {right}")
        lines = out
    else:
        lines += [""] + detail(sel, day, state, cols - 4, now)
    return lines, hits


def detail(item, day, state, width, now):
    """The selected item in full: when, where, description, link."""
    if item is None:
        allday, timed = day_items(state, day)
        n = len(allday) + len(timed)
        return ["", f"{rgb(FG, True)}{day:%A, %d %B}{R}", "",
                f"{rgb(MUTED)}{n} item{'s' if n != 1 else ''}{R}" if n else f"{rgb(MUTED)}Nothing planned.{R}",
                "", f"{rgb(FAINT)}a  add an event on this day{R}"]
    color = SP if is_sp(item) else ACCENT if item["kind"] == "ev" else MUTED
    kind = {"ev": item.get("cal", "Event"), "rem": "Reminder", "note": "SlidePlate video"}[item["kind"]]
    if is_sp(item) and item["kind"] != "note":
        kind += " · SlidePlate"
    out = ["", f"{rgb(color, True)}{kind.upper()}{R}", ""]
    out += [f"{rgb(FG, True)}{l}{R}" for l in wrap(item["title"], width)]
    out.append("")
    if item["kind"] == "rem":
        when = f"{item['due']:%a %d %b}" + ("" if item["all_day"] else f" {item['due']:%H:%M}") if item["due"] else "no date"
        due, c = due_label(item, now)
        out.append(f"{rgb(c if c == RED else MUTED)}due {when}{R}")
    elif item["kind"] == "note":
        out.append(f"{rgb(MUTED)}{item['start']:%A %d %B}{R}")
    else:
        last = (item["end"] - dt.timedelta(seconds=1)).date()
        if item["all_day"]:
            when = f"{item['start']:%a %d %b}" + (f" – {last:%a %d %b}" if last != item["start"].date() else "") + " · all day"
        else:
            when = f"{item['start']:%a %d %b} · {span(item)}"
        out.append(f"{rgb(MUTED)}{when}{R}")
        if item["where"]:
            out += [f"{rgb(FAINT)}{l}{R}" for l in wrap(item["where"], width)]
    desc = clean(item.get("desc", ""))
    link = item_link(item)
    if desc:
        out.append("")
        out += [f"{rgb(FG)}{l}{R}" for l in wrap(LINK.sub("", desc).strip() or desc, width)][:18]
    out.append("")
    if link and link.startswith("obsidian://"):
        target = urllib.parse.unquote(link.split("file=")[-1].split("&")[0])
        out.append(f"{rgb(SP if is_sp(item) else ACCENT)}↗ enter  open in Obsidian{R}")
        out += [f"{rgb(FAINT)}{l}{R}" for l in wrap(target, width)]
    elif link:
        out.append(f"{rgb(ACCENT)}↗ enter  open {short(re.sub(r'^https?://', '', link), width - 13)}{R}")
    if item["kind"] == "rem":
        out.append(f"{rgb(FAINT)}space  mark done{R}")
    return out


def prompt(label, hint=""):
    """Read one line at the bottom of the popup (cbreak mode). None on escape."""
    size = os.get_terminal_size()
    buf = ""
    while True:
        sys.stdout.write(f"\033[{size.lines};1H\033[2K  {rgb(ACCENT, True)}{label}{R} {buf}"
                         f"{rgb(FAINT)}{'' if buf else hint}{R}\033[?25h")
        if not buf and hint:
            sys.stdout.write(f"\033[{size.lines};{4 + len(label)}H")
        sys.stdout.flush()
        ch = os.read(sys.stdin.fileno(), 64).decode(errors="ignore")
        if ch.startswith("\033"):
            if ch == "\033":
                sys.stdout.write("\033[?25l")
                return None
            continue
        for c in ch:
            if c in "\r\n":
                sys.stdout.write("\033[?25l")
                return buf
            if c in "\x7f\b":
                buf = buf[:-1]
            elif c == "\x15":  # ctrl-u
                buf = ""
            elif c.isprintable():
                buf += c


# ── waybar ─────────────────────────────────────────────

def cmd_waybar():
    if not calendars():
        return print(json.dumps({"text": "", "tooltip": f"Add calendars to {CONF}"}))
    try:
        evs = events(3)
    except Exception as e:
        return print(json.dumps({"text": "", "class": "error", "tooltip": f"gcal: {e}"}))

    now = dt.datetime.now().astimezone()
    current, upcoming = now_next(evs, now)
    text, cls = "", "idle"
    if current:
        text, cls = f"{esc(short(current['title'], 26))}  <span alpha='55%'>until {current['end']:%H:%M}</span>", "now"
    elif upcoming and upcoming["start"] - now < dt.timedelta(hours=12):
        title = esc(short(upcoming["title"], 26))
        if upcoming["start"] - now < dt.timedelta(hours=1):
            text, cls = f"{title}  <span alpha='55%'>in {until(upcoming['start'] - now)}</span>", "soon"
        else:
            text = f"<span alpha='55%'>{upcoming['start']:%H:%M}</span>  {title}"

    lines = []
    if current:
        lines.append(f"<span color='{GREEN}'>●</span> <b>{esc(current['title'])}</b>  "
                     f"<span alpha='55%'>ends in {until(current['end'] - now)}</span>")
    if upcoming:
        lines.append(f"<span color='{ACCENT}'>→</span> <b>{esc(upcoming['title'])}</b>  "
                     f"<span alpha='55%'>in {until(upcoming['start'] - now)}</span>")
    last = None
    for ev in evs:
        d = ev["start"].date()
        if d != last:
            color = GREEN if d == dt.date.today() else ACCENT
            lines.append(f"\n<span color='{color}'><b>{day_label(d)}</b></span>")
            last = d
        lines.append(f"<span alpha='55%'>{span(ev):<11}</span>  {esc(short(ev['title'], 40))}")
    now_d = now.date()
    try:
        if reminders_stale() and ICLOUD.exists():
            fetch_reminders()
    except Exception:
        pass  # the cached list is good enough for a tooltip
    due = [r for r in reminders() if r["due"] and r["due"].date() <= now_d + dt.timedelta(days=1)]
    if due:
        lines.append(f"\n<span color='{ACCENT}'><b>Reminders</b></span>")
        for r in due[:6]:
            label, color = due_label(r, now)
            lines.append(f"<span color='{color}'>{label:<11}</span>  {esc(short(r['title'], 40))}")
    tooltip = "\n".join(lines).strip() if lines else "Nothing in the next 3 days"
    print(json.dumps({"text": text, "class": cls, "tooltip": tooltip}))


# ── hyprlock ───────────────────────────────────────────

LOCK_LINES = 17  # fixed height, so hyprlock's centered label keeps its top edge in place


def cmd_lock():
    """Agenda + reminders as pango markup for the right column of hyprlock.conf."""
    now = dt.datetime.now().astimezone()
    label = lambda s: f"<span size='small' foreground='{FAINT}' letter_spacing='2048'>{s}</span>"
    lines = [label("UPCOMING")]
    try:
        evs = events(3) if calendars() else []
    except Exception:
        evs = []
    last, shown = None, 0
    for ev in evs:
        if ev["end"] <= now or shown == 6:
            continue
        d = ev["start"].date()
        if d != last:
            color = GREEN if d == now.date() else ACCENT
            lines += ["", f"<span color='{color}'><b>{day_label(d)}</b></span>"]
            last = d
        lines.append(f"<span color='{MUTED}'>{span(ev):<11}</span>  {esc(short(ev['title'], 30))}")
        shown += 1
    if not shown:
        lines += ["", f"<span color='{MUTED}'>Nothing in the next 3 days</span>"]

    rems = reminders()  # cache only: waybar keeps it fresh, the lock screen never hits iCloud
    if rems:
        lines += ["", "", label("REMINDERS"), ""]
        for r in rems[:5]:
            due, color = due_label(r, now)
            flag = f"<span color='{RED}'>!</span> " if r["priority"] == 1 else ""
            lines.append(f"<span color='{MUTED}'>○</span>  {flag}{esc(short(r['title'], 24))}"
                         + (f"  <span color='{color}'>{due}</span>" if due else ""))
        if len(rems) > 5:
            lines.append(f"<span color='{FAINT}'>   +{len(rems) - 5} more</span>")
    lines = lines[:LOCK_LINES]
    # hyprlock trims trailing blank lines, so the padding ends on an invisible dot
    lines += [""] * (LOCK_LINES - 1 - len(lines)) + ["<span alpha='1%'>.</span>"]
    print("\n".join(lines))


# ── popup ──────────────────────────────────────────────

def rgb(hex_, bold=False):
    r, g, b = (int(hex_[i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[{'1;' if bold else ''}38;2;{r};{g};{b}m"


def bg(hex_):
    r, g, b = (int(hex_[i:i + 2], 16) for i in (1, 3, 5))
    return f"\033[48;2;{r};{g};{b}m"


R = "\033[0m"
SEL = bg("#262636")    # keyboard selection
HOVER = bg("#1b1b27")  # row under the mouse


def visible(s):
    return text_width(re.sub(r"\033\[[0-9;]*m", "", s))


# A rendered line is (text, item): `item` is the event or reminder it shows, or None.

def row(width, left, right=""):
    """Left text with right text pushed to the edge of a `width`-column area."""
    return f"  {left}{' ' * max(1, width - visible(left) - visible(right))}{right}"


def progress(ev, now, width):
    done = (now - ev["start"]) / (ev["end"] - ev["start"])
    n = round(max(0.0, min(1.0, done)) * width)
    return f"{rgb(GREEN)}{'━' * n}{rgb(FG_GHOST)}{'━' * (width - n)}{R}"


def heading(label, width, color):
    return f"  {rgb(color, True)}{label}{R} {rgb(FG_GHOST)}{'─' * max(2, width - len(label) - 1)}{R}"


def month_grid(today, busy):
    import calendar
    lines = ["  " + " ".join(f"{rgb(FAINT)}{d}{R}" for d in ("Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"))]
    for week in calendar.Calendar().monthdayscalendar(today.year, today.month):
        cells = []
        for n in week:
            if n == 0:
                cells.append("  ")
            elif n == today.day:
                cells.append(f"{bg(GREEN)}\033[1;38;2;14;14;20m{n:>2}{R}")
            elif n < today.day:
                cells.append(f"{rgb(FG_GHOST)}{n:>2}{R}")
            elif dt.date(today.year, today.month, n) in busy:
                cells.append(f"{rgb(ACCENT, True)}{n:>2}{R}")
            else:
                cells.append(f"{rgb(MUTED)}{n:>2}{R}")
        lines.append("  " + " ".join(cells))
    return [(l, None) for l in lines]


def overview(evs, now, width, stacked=False):
    """Date, now/next. `stacked` puts titles on their own line, for a narrow column."""
    lines = ["", row(width, f"{rgb(FG, True)}{now:%A, %d %B}{R}", f"{rgb(MUTED)}{now:%H:%M}{R}"), ""]
    current, upcoming = now_next(evs, now)
    out = [(l, None) for l in lines]
    if stacked:
        if current:
            out += [(row(width, f"{rgb(GREEN, True)}NOW{R}", f"{rgb(MUTED)}ends in {until(current['end'] - now)}{R}"), current),
                    (f"  {rgb(FG, True)}{short(current['title'], width)}{R}", current),
                    (f"  {progress(current, now, width)}", current), ("", None)]
        if upcoming:
            soon = upcoming["start"] - now < dt.timedelta(hours=1)
            when = f"{upcoming['start']:%a %H:%M}" + (f" · {upcoming['where']}" if upcoming["where"] else "")
            out += [(row(width, f"{rgb(ACCENT, True)}NEXT{R}",
                         f"{rgb(YELLOW if soon else MUTED)}in {until(upcoming['start'] - now)}{R}"), upcoming),
                    (f"  {rgb(FG)}{short(upcoming['title'], width)}{R}", upcoming),
                    (f"  {rgb(FAINT)}{short(when, width)}{R}", upcoming)]
        if not (current or upcoming):
            out.append((f"  {rgb(MUTED)}Nothing coming up.{R}", None))
        return out
    title_w = width - 22
    if current:
        out.append((row(width, f"{rgb(GREEN, True)}NOW{R}   {rgb(FG, True)}{short(current['title'], title_w)}{R}",
                        f"{rgb(MUTED)}ends in {until(current['end'] - now)}{R}"), current))
        out.append((f"        {progress(current, now, width - 6)}", current))
    if upcoming:
        soon = upcoming["start"] - now < dt.timedelta(hours=1)
        out.append((row(width, f"{rgb(ACCENT, True)}NEXT{R}  {rgb(FG)}{short(upcoming['title'], title_w)}{R}",
                        f"{rgb(YELLOW if soon else MUTED)}in {until(upcoming['start'] - now)}{R}"), upcoming))
        where = f"  ·  {short(upcoming['where'], width - 20)}" if upcoming["where"] else ""
        out.append((f"        {rgb(FAINT)}{upcoming['start']:%a %H:%M}{where}{R}", upcoming))
    if not (current or upcoming):
        out.append((f"  {rgb(MUTED)}Nothing coming up.{R}", None))
    return out


BUCKETS = [("Overdue", RED), ("Today", YELLOW), ("Tomorrow", ACCENT),
           ("This week", ACCENT), ("Later", MUTED), ("No date", FAINT)]


def bucket(rem, now):
    due = rem["due"]
    if not due:
        return "No date"
    d, today = due.date(), now.date()
    if d < today or (not rem["all_day"] and due < now):
        return "Overdue"
    if d == today:
        return "Today"
    if d == today + dt.timedelta(days=1):
        return "Tomorrow"
    return "This week" if d < today + dt.timedelta(days=7) else "Later"


def reminder_lines(rems, now, width, status=""):
    """Reminders grouped by when they are due."""
    out = [("", None), (heading(f"Tasks · {len(rems)} open", width, ACCENT), None)]
    if status:
        out.append((f"  {rgb(FAINT)}{status}{R}", None))
    groups = {}
    for rem in rems:
        groups.setdefault(bucket(rem, now), []).append(rem)
    for name, color in BUCKETS:
        if name not in groups:
            continue
        out += [("", None), (f"  {rgb(color, True)}{name}{R} {rgb(FAINT)}{len(groups[name])}{R}", None)]
        for rem in groups[name]:
            due, due_color = due_label(rem, now)
            if name in ("Today", "Tomorrow"):
                due = "" if rem["all_day"] else f"{rem['due']:%H:%M}"
            flag = f"{rgb(RED, True)}!{R} " if rem["priority"] == 1 else ""
            link = f" {rgb(ACCENT)}↗{R}" if rem["link"] else ""
            room = width - len(due) - 5 - (2 if flag else 0) - (2 if link else 0)
            out.append((row(width, f"{rgb(MUTED)}○{R}  {flag}{rgb(FG)}{short(rem['title'], room)}{R}{link}",
                            f"{rgb(due_color)}{due}{R}"), rem))
    if not rems and not status:
        out.append((f"  {rgb(MUTED)}All done.{R}", None))
    return out


def stats(evs, rems, now, width):
    """Counts at a glance."""
    counts = {}
    for rem in rems:
        counts[bucket(rem, now)] = counts.get(bucket(rem, now), 0) + 1
    week_end = now.date() + dt.timedelta(days=7)
    today_evs = sum(1 for e in evs if e["start"].date() == now.date() and (e["all_day"] or e["end"] > now))
    week_evs = sum(1 for e in evs if now.date() <= e["start"].date() < week_end and (e["all_day"] or e["end"] > now))
    lines = [
        ("Overdue tasks", counts.get("Overdue", 0), RED),
        ("Due today", counts.get("Today", 0), YELLOW),
        ("Due this week", sum(counts.get(b, 0) for b in ("Today", "Tomorrow", "This week")), ACCENT),
        ("Events left today", today_evs, GREEN),
        ("Events next 7 days", week_evs, GREEN),
    ]
    out = [("", None), (heading("At a glance", width, ACCENT), None), ("", None)]
    for label, n, color in lines:
        out.append((row(width, f"{rgb(MUTED)}{label}{R}", f"{rgb(color if n else FAINT, True)}{n}{R}"), None))
    return out


def agenda(evs, now, width, wide=False, rems=()):
    """Events and dated reminders grouped by day; `wide` adds the location on the same line.
    Overdue reminders sit under today."""
    current, _ = now_next(evs, now)
    entries = [(e["start"].date(), 0 if e["all_day"] else 1, e["start"], e) for e in evs]
    for rem in rems:
        if rem["due"]:
            d = max(rem["due"].date(), now.date())
            entries.append((d, 0 if rem["all_day"] else 1, rem["due"], rem))
    entries.sort(key=lambda x: x[:3])
    out, last = [], None
    for d, _, _, ev in entries:
        if d != last:
            out += [("", None), (heading(day_label(d), width, GREEN if d == now.date() else ACCENT), None)]
            last = d
        if ev["kind"] == "rem":
            due, color = due_label(ev, now)
            when = "today" if ev["all_day"] else f"{ev['due']:%H:%M}"
            if color == RED:
                when = due  # overdue: keep the real day
            flag = f"{rgb(RED, True)}!{R} " if ev["priority"] == 1 else ""
            room = width - 19 - (2 if flag else 0) - (2 if ev["link"] else 0)
            line = (f"  {rgb(FG_GHOST)}▏{R} {rgb(RED if color == RED else MUTED)}{when:<11}{R}  "
                    f"{rgb(ACCENT)}○{R} {flag}{rgb(FG)}{short(ev['title'], room)}{R}")
            if ev["link"]:
                line += f" {rgb(ACCENT)}↗{R}"
            out.append((line, ev))
            continue
        past = not ev["all_day"] and ev["end"] <= now
        live = ev is current
        mark = f"{rgb(GREEN)}▌" if live else f"{rgb(FG_GHOST)}▏"
        t_col, n_col = (FG_GHOST, FAINT) if past else (MUTED, FG)
        room = width - 16 - (2 if ev["link"] else 0)
        title = short(ev["title"], room if not wide else min(room, 34))
        line = f"  {mark}{R} {rgb(t_col)}{span(ev):<11}{R}  {rgb(n_col, live)}{title}{R}"
        if ev["link"]:
            line += f" {rgb(ACCENT)}↗{R}"
        if wide and ev["where"] and room - len(title) > 8:
            line += f"  {rgb(FAINT)}{short(ev['where'], room - len(title) - 2)}{R}"
        out.append((line, ev))
    if last is None:
        out += [("", None), (f"  {rgb(MUTED)}Nothing in the next weeks.{R}", None)]
    return out


def layout(state, cols):
    """→ columns, each (lines, x_from, x_to): one for the popup, two or three for the overlay."""
    now = dt.datetime.now().astimezone()
    evs, rems = state["events"], state["reminders"]
    busy = {e["start"].date() for e in evs}
    head = [("", None), (f"  {rgb(RED)}{short(state['error'], cols - 4)}{R}", None)] if state["error"] else []
    if cols < 100:
        w = cols - 4
        lines = (head + overview(evs, now, w)
                 + reminder_lines(rems, now, w, state["rem_status"])
                 + [("", None)] + month_grid(now.date(), busy)
                 + agenda(evs, now, w, rems=rems))
        return [(lines, 0, cols)]

    if cols < 140:
        left_w = 50
        left = (head + overview(evs, now, left_w - 4)
                + reminder_lines(rems, now, left_w - 4, state["rem_status"])
                + [("", None), ("", None)] + month_grid(now.date(), busy))
        return [(left, 0, left_w), (agenda(evs, now, cols - left_w - 6, wide=True, rems=rems), left_w, cols)]

    # overview | tasks | agenda
    a = 34
    b = a + (cols - a) * 47 // 100
    first = (head + overview(evs, now, a - 4, stacked=True)
             + [("", None), ("", None)] + month_grid(now.date(), busy)
             + stats(evs, rems, now, a - 4))
    return [(first, 0, a),
            (reminder_lines(rems, now, b - a - 6, state["rem_status"]), a, b),
            (agenda(evs, now, cols - b - 6, wide=True, rems=rems), b, cols)]


def follow(lines, item, off, height):
    """Scroll offset that keeps `item` (with a little context) inside the column."""
    idx = next((i for i, (_, it) in enumerate(lines) if it is item), None)
    if idx is not None:
        if idx < off + 1:
            off = idx - 3
        elif idx > off + height - 3:
            off = idx - height + 4
    return max(0, min(off, len(lines) - height))


def compose(columns, offsets, height):
    """Columns → rows of cells [(text, item, x_from, x_to), ...], each column at its own offset."""
    rows = [[] for _ in range(height)]
    for n, (lines, x0, x1) in enumerate(columns):
        off = offsets[n]
        view = lines[off:off + height]
        if off:
            view[0] = (f"  {rgb(FAINT)}↑ {off} more{R}", None)
        hidden = len(lines) - off - height
        if hidden > 0:
            view[-1] = (f"  {rgb(FAINT)}↓ {hidden + 1} more{R}", None)
        view += [("", None)] * (height - len(view))
        sep = f"{rgb(FG_GHOST)}│{R}" if n else ""
        for y, (text, item) in enumerate(view):
            rows[y].append((sep + text, item, x0, x1))
    return rows


def paint(rows, selected, hovered, height):
    out = []
    for cells in rows[:height]:
        line = ""
        for text, item, x0, x1 in cells:
            w = x1 - x0
            pad = " " * max(0, w - visible(text))
            shade = item is not None and (SEL if item is selected else HOVER if item is hovered else None)
            if shade:
                line += shade + text.replace(R, R + shade) + pad + R
            else:
                line += text + pad
        out.append(line)
    return out


def selectable(columns):
    """Items in reading order (left column first), each once."""
    seen, order = set(), []
    for lines, _, _ in columns:
        for _, item in lines:
            if item is not None and id(item) not in seen:
                seen.add(id(item))
                order.append(item)
    return order


def open_link(item):
    url = item_link(item)
    if url:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    return bool(url)


def calendar_key(data, state, week, hits, view):
    """Keys and clicks on the calendar tab. True closes the popup."""
    import threading

    sel, day = state["cal_sel"], state["cal_day"]
    mouse = list(re.finditer(r"\033\[<(\d+);(\d+);(\d+)([Mm])", data))
    for m in mouse:
        b, x, y, kind = int(m[1]), int(m[2]) - 1, int(m[3]) - 1, m[4]
        if b & 32 or kind != "M":
            continue
        if b in (64, 65):
            state["cal_day"] = day + dt.timedelta(days=7 if b == 65 else -7)
            state["cal_sel"] = None
            continue
        hit = next((h for h in hits if h[0] == y and h[1] <= x < h[2]), None)
        if hit and b == 0:
            d, item = hit[3]
            if item is sel:
                return open_link(item)
            state["cal_day"], state["cal_sel"] = d, item
    if mouse:
        return False

    def move_day(n):
        state["cal_day"] = day + dt.timedelta(days=n)
        state["cal_sel"] = None

    if data in ("q", "\033"):
        return True
    if data in ("1", "\t"):
        state["tab"] = "home"
    elif data in ("h", "\033[D"):
        move_day(-1)
    elif data in ("l", "\033[C"):
        move_day(1)
    elif data in ("[", "\033[5~", "H"):
        move_day(-7)
    elif data in ("]", "\033[6~", "L"):
        move_day(7)
    elif data == "t":
        state["cal_day"], state["cal_sel"] = dt.date.today(), None
    elif data in ("j", "\033[B", "k", "\033[A"):
        step = 1 if data in ("j", "\033[B") else -1
        on_day = [i for d, i in week if d == day]
        if on_day:
            i = next((n for n, it in enumerate(on_day) if it is sel), -1 if step > 0 else len(on_day))
            state["cal_sel"] = on_day[max(0, min(len(on_day) - 1, i + step))]
    elif data in ("\r", "\n", "o"):
        if sel is not None:
            return open_link(sel)
        on_day = [i for d, i in week if d == day]
        state["cal_sel"] = on_day[0] if on_day else None
    elif data in (" ", "x") and sel is not None and sel["kind"] == "rem":
        state["finish"](sel)
        state["cal_sel"] = None
    elif data == "a":
        text = prompt(f"new event on {day:%a %d %b}:", "title @ 14:00-15:00 | description   (no @ = all day, @ fri 9:00 for another day)")
        if text and text.strip():
            try:
                ev = add_event(text, day)
                state["week_events"].append(ev)
                state["events"].append(ev)
                state["cal_day"], state["cal_sel"] = ev["start"].date(), ev
                state["msg"] = f"added {ev['title']}"
            except Exception as e:
                state["msg"] = f"not added: {e}"
    elif data == "r":
        state["reload"]()
    return False


def cmd_popup():
    import select
    import termios
    import threading
    import tty

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    wake_r, wake_w = os.pipe()  # background work pokes this to trigger a redraw
    today = dt.date.today()
    state = {"events": [], "reminders": [], "error": "", "rem_status": "", "done": set(),
             "tab": "home", "cal_day": today, "cal_sel": None, "week_events": [], "range": None,
             "notes": [], "msg": ""}
    TAB = CACHE / "tab"
    if TAB.exists() and TAB.read_text().strip() in ("home", "cal"):
        state["tab"] = TAB.read_text().strip()  # SUPER+K opens on the tab used last

    def load_events(force=False):
        try:
            state["events"] = events(28, force, keep_past=True) if calendars() else []
            state["error"] = "" if calendars() else f"No calendars configured — add them to {CONF}"
        except Exception as e:
            state["error"] = f"Could not load calendar: {e}"
        state["range"] = None
        state["notes"] = vault_notes()

    def load_week():
        """Events around the week on screen, refetched when the view leaves the loaded range."""
        monday = state["cal_day"] - dt.timedelta(days=state["cal_day"].weekday())
        rng = state["range"]
        if rng and rng[0] <= monday and monday + dt.timedelta(days=7) <= rng[1]:
            return
        start = monday - dt.timedelta(days=7)
        try:
            state["week_events"] = events(35, keep_past=True,
                                          start=dt.datetime.combine(start, dt.time()).astimezone()) if calendars() else []
        except Exception as e:
            state["error"] = f"Could not load calendar: {e}"
        state["range"] = (start, start + dt.timedelta(days=35))

    def load_reminders(force=False):
        state["reminders"] = reminders(state["done"])
        if not ICLOUD.exists():
            state["rem_status"] = "pyicloud not installed"
            return
        if not (force or reminders_stale()):
            return
        if not REM_CACHE.exists():
            state["rem_status"] = "loading…"

        def work():
            try:
                fetch_reminders()
                state["rem_status"] = ""
            except Exception as e:
                state["rem_status"] = f"iCloud: {e}"
            state["reminders"] = reminders(state["done"])
            os.write(wake_w, b"x")
        threading.Thread(target=work, daemon=True).start()

    def finish(item):
        state["done"].add(item["id"])
        state["reminders"] = reminders(state["done"])

        def work():
            try:
                complete(item["id"])
                fetch_reminders()
            except Exception as e:
                state["done"].discard(item["id"])
                state["rem_status"] = f"iCloud: {e}"
            state["reminders"] = reminders(state["done"])
            os.write(wake_w, b"x")
        threading.Thread(target=work, daemon=True).start()

    state["finish"], state["reload"] = finish, lambda: (load_events(True), load_reminders(True))
    state["wake"] = lambda: os.write(wake_w, b"x")
    load_events()
    load_reminders()
    selected = hovered = None
    pointer = "default"
    offsets = []

    def set_pointer(shape):
        # kitty OSC 22: mouse pointer shape for this window
        nonlocal pointer
        if shape != pointer:
            sys.stdout.write(f"\033]22;{shape}\033\\")
            pointer = shape

    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l\033[?1003h\033[?1006h")  # hide cursor, SGR mouse incl. motion
        while True:
            size = os.get_terminal_size()
            height = size.lines - 2
            if state["tab"] == "cal":
                load_week()
                view = {**state, "events": state["week_events"]}
                monday = state["cal_day"] - dt.timedelta(days=state["cal_day"].weekday())
                week = week_items(view, monday)
                if state["cal_sel"] is not None and not any(i is state["cal_sel"] for _, i in week):
                    key = lambda i: i.get("id") or i.get("link") or (i["title"], i.get("start"))
                    old = key(state["cal_sel"])
                    state["cal_sel"] = next((i for _, i in week if key(i) == old), None)
                lines, hits = week_view(view, size.columns, height)
                body = [l for l in lines[:height]] + [""] * max(0, height - len(lines))
                msg = f"{rgb(YELLOW)}{state['msg']}{R}  " if state["msg"] else ""
                hint = (f"  {msg}{rgb(FAINT)}1 overview  {R}{rgb(ACCENT, True)}2 calendar{R}{rgb(FAINT)}  ·  "
                        f"←→ day · ↑↓ item · [ ] week · t today · enter open · a add · q close{R}")
                sys.stdout.write("\033[H\033[2J" + "\n".join(body) + f"\033[{size.lines};1H" + hint)
                sys.stdout.flush()
                ready = select.select([fd, wake_r], [], [], 30)[0]
                if wake_r in ready:
                    os.read(wake_r, 64)
                if fd not in ready:
                    continue
                data = os.read(fd, 64).decode(errors="ignore")
                state["msg"] = ""
                if calendar_key(data, state, week, hits, view):
                    break
                continue
            columns = layout(state, size.columns)
            items = selectable(columns)
            if selected is not None and not any(i is selected for i in items):
                # the item list was rebuilt: keep the selection on the same thing
                key = selected.get("id") or (selected["title"], selected["start"])
                selected = next((i for i in items if (i.get("id") or (i["title"], i.get("start"))) == key), None)
            if hovered is not None and not any(i is hovered for i in items):
                hovered = None
            if len(offsets) != len(columns):
                offsets = [0] * len(columns)
            offsets = [follow(lines, selected, off, height) for (lines, _, _), off in zip(columns, offsets)]
            rows = compose(columns, offsets, height)
            body = paint(rows, selected, hovered, height)
            hint = (f"  {rgb(ACCENT, True)}1 overview{R}{rgb(FAINT)}  2 calendar  ·  "
                    f"↑↓ select · enter open · space done · r refresh · q close{R}")
            sys.stdout.write("\033[H\033[2J" + "\n".join(body) + f"\033[{size.lines};1H" + hint)
            sys.stdout.flush()

            ready = select.select([fd, wake_r], [], [], 30)[0]
            if wake_r in ready:
                os.read(wake_r, 64)
            if fd not in ready:
                continue
            data = os.read(fd, 64).decode(errors="ignore")

            mouse = list(re.finditer(r"\033\[<(\d+);(\d+);(\d+)([Mm])", data))
            if mouse:
                close = False
                for m in mouse:
                    b, x, y, kind = int(m[1]), int(m[2]) - 1, int(m[3]) - 1, m[4]
                    cell = next((c for c in rows[y] if c[2] <= x < c[3]), None) if y < len(rows) else None
                    item = cell[1] if cell else None
                    if b & 32:  # motion: hover highlight + hand pointer over anything clickable
                        hovered = item
                        set_pointer("pointer" if item else "default")
                    elif b in (64, 65) and items:  # wheel moves the selection
                        i = next((n for n, it in enumerate(items) if it is selected), -1)
                        selected = items[max(0, min(len(items) - 1, i + (1 if b == 65 else -1)))]
                    elif b == 0 and kind == "M" and item:
                        ring = re.sub(r"\033\[[0-9;]*m", "", cell[0]).find("○")
                        if item["kind"] == "rem" and abs(x - cell[2] - ring) <= 1:  # the ○ checks it off
                            finish(item)
                            hovered = None
                        elif open_link(item):
                            close = True
                        else:
                            selected = item
                if close:
                    break
                continue

            if data in ("q", "\033"):
                break
            if data in ("2", "\t"):
                state["tab"] = "cal"
                continue
            if data in ("j", "\033[B", "k", "\033[A") and items:
                i = next((n for n, it in enumerate(items) if it is selected), -1)
                step = -1 if data in ("k", "\033[A") else 1
                selected = items[(i + step) % len(items)] if i >= 0 or step > 0 else items[-1]
            elif data in ("\r", "\n", "o"):
                if selected is None and data == "o":
                    open_link({"kind": "ev"})
                    break
                if selected is not None and open_link(selected):
                    break
            elif data in (" ", "x") and selected is not None and selected["kind"] == "rem":
                items_before = items
                finish(selected)
                i = next((n for n, it in enumerate(items_before) if it is selected), 0)
                rest = [it for it in items_before if it is not selected]
                selected = rest[min(i, len(rest) - 1)] if rest else None
            elif data == "r":
                load_events(force=True)
                load_reminders(force=True)
    finally:
        CACHE.mkdir(parents=True, exist_ok=True)
        TAB.write_text(state["tab"])
        sys.stdout.write("\033[?1003l\033[?1006l\033[?25h\033]22;default\033\\")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def dispatch(lua):
    # Hyprland's Lua config: `hyprctl dispatch` takes an hl.dsp.* expression
    subprocess.run(["hyprctl", "dispatch", lua], stdout=subprocess.DEVNULL)


def cmd_toggle(big=False):
    """Small popup under the bar, or with --big a large centered overlay."""
    cls = OVERLAY_CLASS if big else POPUP_CLASS
    clients = json.loads(subprocess.check_output(["hyprctl", "clients", "-j"]))
    if any(c.get("class") == cls for c in clients):
        dispatch(f'hl.dsp.window.close({{ window = "class:^({cls})$" }})')
        return
    mon = next(m for m in json.loads(subprocess.check_output(["hyprctl", "monitors", "-j"]))
               if m["focused"])
    # the move rule is relative to the monitor, so no mon["x"]/mon["y"] offset
    mw, mh = mon["width"] / mon["scale"], mon["height"] / mon["scale"]
    if big:
        w, h = int(mw * 0.86), int(mh * 0.84)
        x, y = int((mw - w) / 2), int((mh - h) / 2)
        extra = "-o font_size=13 -o window_padding_width=28 -o background_opacity=0.97"
        rules_extra = ", dim_around = true, stay_focused = true"
    else:
        w, h = POPUP_W, POPUP_H
        x, y = int((mw - w) / 2), 52  # bar height + top margin + gap
        extra = "-o window_padding_width=14 -o background_opacity=0.94"
        rules_extra = ""
    cmd = (f"kitty --class {cls} -o confirm_os_window_close=0 -o background=#0e0e14 {extra} "
           f"-e {Path(__file__).resolve()} popup")
    rules = f'{{ float = true, pin = true, size = "{w} {h}", move = "{x} {y}"{rules_extra} }}'
    dispatch(f"hl.dsp.exec_cmd({json.dumps(cmd)}, {rules})")


if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else "waybar"
    if arg == "toggle":
        cmd_toggle(big="--big" in sys.argv)
    else:
        {"waybar": cmd_waybar, "popup": cmd_popup, "lock": cmd_lock,
         "add": cmd_add, "auth": cmd_auth}.get(arg, cmd_waybar)()
