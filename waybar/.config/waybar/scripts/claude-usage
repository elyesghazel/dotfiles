#!/usr/bin/python3
"""Claude plan usage for waybar: the 5-hour session and the weekly limit.

    claude-usage          JSON for the custom/claude module

Reads the OAuth token Claude Code keeps in ~/.claude/.credentials.json and asks the same
endpoint `/usage` does. The token is only ever sent to api.anthropic.com. Claude Code
refreshes it on its own, so after a long idle the module shows the last cached numbers
until the next `claude` run. Responses are cached for TTL seconds; the endpoint is
rate-limited and the numbers move slowly, and a 429 is honoured via Retry-After: polling
through it keeps the limit from ever lifting.
"""

import datetime as dt
import json
import os
import urllib.error
import urllib.request
from pathlib import Path

CREDS = Path.home() / ".claude/.credentials.json"
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "waybar-claude.json"
BACKOFF = CACHE.with_suffix(".backoff")  # epoch seconds before which we don't ask again
URL = "https://api.anthropic.com/api/oauth/usage"
TTL = 300

# Claude Code's own spark, in Claude orange
CLAUDE = "#d97757"
LOGO = f"<span color='{CLAUDE}' size='115%'>✻</span>"
FAINT, YELLOW, RED = "#5a5a6a", "#f9e2af", "#f38ba8"


def fetch():
    token = json.loads(CREDS.read_text())["claudeAiOauth"]["accessToken"]
    req = urllib.request.Request(URL, headers={
        "Authorization": f"Bearer {token}",
        "anthropic-beta": "oauth-2025-04-20",
        "Content-Type": "application/json",
        "User-Agent": "claude-code/waybar",  # anything not claude-code/* gets a 429
    })
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            data = json.load(r)
    except urllib.error.HTTPError as e:
        if e.code == 429:
            wait = int(e.headers.get("Retry-After") or 600)
            BACKOFF.write_text(str(dt.datetime.now().timestamp() + wait))
        if e.code == 401:
            raise PermissionError("logged out, run `claude` and /login") from e
        raise
    BACKOFF.unlink(missing_ok=True)
    tmp = CACHE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data))
    tmp.replace(CACHE)
    return data


def usage():
    fresh = CACHE.exists() and dt.datetime.now().timestamp() - CACHE.stat().st_mtime < TTL
    if fresh:
        return json.loads(CACHE.read_text()), None
    until = float(BACKOFF.read_text()) if BACKOFF.exists() else 0
    if until > dt.datetime.now().timestamp():
        err = f"rate limited, retrying {dt.datetime.fromtimestamp(until):%H:%M}"
        if CACHE.exists():
            return json.loads(CACHE.read_text()), err
        raise RuntimeError(err)
    try:
        return fetch(), None
    except PermissionError:
        raise  # old numbers would hide that nothing is updating
    except Exception as e:
        if CACHE.exists():
            return json.loads(CACHE.read_text()), e  # stale beats nothing
        raise


def resets(iso):
    """'Resets 19:00 · in 2h 42m', or 'Resets Fri 09:00 · in 4d 22h' past today."""
    if not iso:
        return "Resets —"
    at = dt.datetime.fromisoformat(iso.replace("Z", "+00:00")).astimezone()
    mins = max(0, int((at - dt.datetime.now(dt.timezone.utc)).total_seconds() // 60))
    d, h, m = mins // 1440, mins // 60 % 24, mins % 60
    left = f"{d}d {h}h" if d else f"{h}h {m:02d}m" if h else f"{m}m"
    when = at.strftime("%H:%M" if at.date() == dt.date.today() else "%a %H:%M")
    return f"Resets {when} · in {left}"


def bar(pct, width=32):
    """Eighth-block bar like Claude Code's /usage, coloured by how close the limit is."""
    eighths = round(min(max(pct, 0), 100) / 100 * width * 8)
    full, part = divmod(eighths, 8)
    fill = "█" * full + (" ▏▎▍▌▋▊▉"[part] if part else "")
    color = RED if pct >= 90 else YELLOW if pct >= 75 else CLAUDE
    track = "░" * (width - len(fill))
    return f"<span color='{color}'>{fill}</span><span color='{FAINT}'>{track}</span>"


def main():
    try:
        data, err = usage()
    except Exception as e:
        return print(json.dumps({"text": f"{LOGO}  ?", "class": "error", "tooltip": f"claude: {e}"}))

    rows = [("Current session", data.get("five_hour")), ("Current week (all models)", data.get("seven_day")),
            ("Current week (Opus)", data.get("seven_day_opus"))]
    rows = [(name, w) for name, w in rows if w]
    sess = (data.get("five_hour") or {}).get("utilization") or 0
    week = (data.get("seven_day") or {}).get("utilization") or 0

    worst = max(sess, week)
    cls = "critical" if worst >= 90 else "warning" if worst >= 75 else ""
    text = f"{LOGO}  {sess:.0f}%  <span alpha='55%'>{week:.0f}%</span>"
    tip = "\n\n".join(
        f"<b>{name}</b>\n"
        f"<tt>{bar(w['utilization'])}  {w['utilization']:.0f}% used</tt>\n"
        f"<span alpha='55%'>{resets(w.get('resets_at'))}</span>"
        for name, w in rows
    )
    if err:
        tip += f"\n<span color='{FAINT}'>stale: {err}</span>"
    print(json.dumps({"text": text, "class": cls, "tooltip": tip}))


if __name__ == "__main__":
    main()
