{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin": "10 10 0 10",
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left":   ["group/left"],
    "modules-center": ["group/center"],
    "modules-right":  ["group/right"],

    "group/left": {
        "orientation": "horizontal",
        "modules": ["custom/start", "hyprland/workspaces", "wlr/taskbar", "mpris"]
    },

    "group/center": {
        "orientation": "horizontal",
        "modules": ["clock", "custom/gcal"]
    },

    "group/right": {
        "orientation": "horizontal",
        "modules": ["group/tray", "custom/claude", "cpu", "memory", "idle_inhibitor", "pulseaudio", "network", "bluetooth", "battery"]
    },

    "group/tray": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 350,
            "transition-left-to-right": false,
            "children-class": "tray-child"
        },
        "modules": ["custom/tray-toggle", "tray"]
    },

    // ── left ────────────────────────────────────────────

    "custom/start": {
        "format": "󰣇",
        "tooltip": false,
        "on-click": "zunder toggle"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-up":   "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "persistent-workspaces": {
            "DP-2":     [1, 2, 3, 4, 5],
            "HDMI-A-2": [6, 7, 8, 9, 10]
        },
        "cursor": true
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 15,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-scroll-up": "minimize-raise"
    },

    "mpris": {
        "format":         "{status_icon}  {title}",
        "format-paused":  "{status_icon}  {title}",
        "status-icons": {
            "playing": "󰏤",
            "paused":  "󰐊"
        },
        "tooltip-format": "{artist} — {title}\n{album}",
        "on-click":       "playerctl play-pause",
        "on-scroll-up":   "playerctl previous",
        "on-scroll-down": "playerctl next",
        "title-len": 28,
        "max-length": 34
    },

    // ── center ──────────────────────────────────────────

    "clock": {
        "timezone": "Europe/Zurich",
        "format":     "<span alpha='55%'>{0:%a %d}</span>   {0:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click":       "~/.config/waybar/scripts/gcal toggle",
        "on-click-right": "kitty --class=peaclock -e peaclock",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "format": {
                "months":   "<b>{}</b>",
                "days":     "{}",
                "weeks":    "<span alpha='40%'>W{}</span>",
                "weekdays": "<span alpha='55%'>{}</span>",
                "today":    "<span color='#b4befe'><b>{}</b></span>"
            }
        }
    },

    "custom/gcal": {
        "exec": "~/.config/waybar/scripts/gcal waybar",
        "return-type": "json",
        "interval": 60,
        "escape": false,
        "on-click": "~/.config/waybar/scripts/gcal toggle"
    },

    // ── right ───────────────────────────────────────────

    "custom/tray-toggle": {
        "format": "󰅁",
        "tooltip": false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    },

    "custom/claude": {
        "exec": "~/.config/waybar/scripts/claude-usage",
        "return-type": "json",
        "interval": 60,
        "escape": false,
        "on-click": "xdg-open https://claude.ai/settings/usage"
    },

    "cpu": {
        "interval": 5,
        "format": "<span font_family='Material Symbols Rounded' size='120%' rise='-2pt'>\ue322</span>  {usage}%",
        "states": { "warning": 80, "critical": 90 }
    },

    "memory": {
        "interval": 5,
        "format": "<span font_family='Material Symbols Rounded' size='120%' rise='-2pt'>\uf7a3</span>  {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
        "states": { "warning": 80, "critical": 90 }
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated":   "󰅶",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated":   "Staying awake: no lock or suspend",
        "tooltip-format-deactivated": "Auto-lock after 5 min"
    },

    "pulseaudio": {
        "format":           "{icon}",
        "format-bluetooth": "{icon}",
        "format-muted":     "󰝟",
        "tooltip-format":   "{desc}  ·  {volume}%",
        "scroll-step": 2,
        "on-click":         "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right":   "pavucontrol",
        "on-scroll-up":     "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down":   "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-",
        "format-icons": {
            "headphone": "󰋋",
            "headset":   "󰋎",
            "default":   ["󰕿", "󰖀", "󰕾"]
        }
    },

    "network": {
        "interval": 10,
        "format-wifi":         "{icon}",
        "format-ethernet":     "󰈀",
        "format-disconnected": "󰤮",
        "format-disabled":     "󰤭",
        "format-icons":        ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi":     "{essid}  ·  {signalStrength}%\n󰁝 {bandwidthUpBytes}   󰁅 {bandwidthDownBytes}",
        "tooltip-format-ethernet": "{ifname}  ·  {ipaddr}\n󰁝 {bandwidthUpBytes}   󰁅 {bandwidthDownBytes}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "kitty gazelle",
        "menu": "on-click-right",
        "menu-file": "~/.config/waybar/context/network.xml",
        "menu-actions": {
            "action-1": "nmcli radio wifi off",
            "action-2": "nmcli radio wifi on",
            "action-3": "hyprctl dispatch 'hl.dsp.exec_cmd(\"kitty -e nmtui\", { float = true })'",
            "action-4": "nm-connection-editor"
        }
    },

    "bluetooth": {
        "format":           "󰂲",
        "format-on":        "󰂯",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias}  <span alpha='55%'>{device_battery_percentage}%</span>",
        "max-length": 28,
        "tooltip-format":           "Bluetooth off",
        "tooltip-format-on":        "Bluetooth on",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected":         "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  ·  {device_battery_percentage}%",
        "on-click": "~/.local/bin/toggle_bluetooth &",
        "menu": "on-click-right",
        "menu-file": "~/.config/waybar/context/bluetooth.xml",
        "menu-actions": {
            "action-1": "bluetoothctl power on",
            "action-2": "bluetoothctl power off",
            "action-3": "kitty bluetui"
        }
    },

    "battery": {
        "interval": 30,
        "full-at": 100,
        "format":          "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged":  "󰚥  {capacity}%",
        "format-full":     "󰁹  Full",
        "format-icons":    ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format":  "{timeTo}  ·  {power:.1f}W",
        "states": { "warning": 30, "critical": 15 }
    }
}
