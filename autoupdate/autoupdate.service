# Unattended pacman -Syu + yay -Sua. Installed by autoupdate/setup.sh.
# Logs:  journalctl -u autoupdate
[Unit]
Description=Unattended pacman + AUR upgrade
Wants=network-online.target
After=network-online.target
# Laptop: never start an upgrade on battery.
ConditionACPower=true
OnFailure=autoupdate-notify.service

[Service]
Type=oneshot
# Hold off suspend for the whole run; autoupdate-pacman blocks shutdown only
# while packages (and mkinitcpio) are being written.
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=autoupdate \
    --why="Upgrading packages" /usr/local/bin/autoupdate
Nice=10
IOSchedulingClass=idle
# First runs after a long gap build big AUR packages from source (webkit2gtk ~1h+).
TimeoutStartSec=6h
