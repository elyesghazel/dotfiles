#!/usr/bin/python3
"""Runs Elyes' zunder plugins (~/dotfiles/zunder/.config/zunder/plugins) for zunder on Windows.

The .cmd wrappers in %APPDATA%\\zunder\\plugins call
    wsl.exe -d Ubuntu -e ~/.local/bin/zunder-wsl <plugin>
with the query in $ZQ (shared through WSLENV). zunder starts a .cmd through Rust's batch
escaping, so ZQ is either a bare word or "…" with every " doubled and backslashes before a
quote doubled; decode() undoes exactly that.

`run` / `term` actions in the plugin's output are POSIX command lines; they get rewritten to
    wsl.exe … zunder-wsl --run <base64>
so cmd.exe on the Windows side only ever sees base64.

`zunder-wsl --sync` writes one wrapper per executable plugin (and removes wrappers of plugins
that are gone), so every plugin in dotfiles shows up on Windows too. Lives in dotfiles at
windows/zunder/; ~/.local/bin/zunder-wsl is a symlink to it (see windows/zunder/README.md).
"""
import base64
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
PLUGINS = HOME / "dotfiles/zunder/.config/zunder/plugins"
SELF = HOME / ".local/bin/zunder-wsl"
SHIMS = Path(__file__).resolve().parent / "bin"  # notify-send, wl-copy, wl-paste → Windows
LOG = HOME / ".cache/zunder-wsl/run.log"
DISTRO = os.environ.get("WSL_DISTRO_NAME") or "Ubuntu"
# conhost --headless gives wsl.exe a console without a window: zunder starts `run` actions
# detached (no console), and a console program started from there would flash a window.
RUN = f"conhost.exe --headless wsl.exe -d {DISTRO} -e {SELF} --run "


def env():
    e = dict(os.environ)
    e["PATH"] = f"{SHIMS}:{HOME}/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
    # this network drops one of glibc's parallel A/AAAA answers: every lookup took ~4.5 s
    e["RES_OPTIONS"] = (e.get("RES_OPTIONS", "") + " single-request").strip()
    e.setdefault("LANG", "C.UTF-8")
    e["PYTHONIOENCODING"] = "utf-8"
    for k in ("ZQ", "WSLENV"):
        e.pop(k, None)
    return e


def decode(raw):
    """Undo Rust's make_bat_command_line quoting of one argument (see module doc)."""
    if not raw.startswith('"'):
        return raw  # never quoted: only letters, digits, non-ASCII and #$*+-./:?@\_
    s = raw[1:-1] if len(raw) >= 2 and raw.endswith('"') else raw[1:]
    out, i = [], 0
    while i < len(s):
        if s[i] == "\\":
            j = i
            while j < len(s) and s[j] == "\\":
                j += 1
            n = j - i
            if j == len(s) or s[j] == '"':  # doubled before a quote or the closing quote
                out.append("\\" * (n // 2))
            else:
                out.append("\\" * n)
            i = j
        elif s[i] == '"':
            out.append('"')
            i += 2 if s[i + 1:i + 2] == '"' else 1
        else:
            out.append(s[i])
            i += 1
    return "".join(out)


def wrap(cmd):
    return RUN + base64.urlsafe_b64encode(cmd.encode()).decode()


def rewrite(action):
    if isinstance(action, dict):
        if isinstance(action.get("run"), str):
            action["run"] = wrap(action["run"])
        elif isinstance(action.get("term"), str):
            action["term"] = f"wsl.exe -d {DISTRO} -e {SELF} --run " + \
                base64.urlsafe_b64encode(action["term"].encode()).decode()


def run_plugin(name):
    path = PLUGINS / name
    if not path.is_file():
        print(f"zunder-wsl: no plugin {path}", file=sys.stderr)
        return 1
    query = decode(os.environ.get("ZQ", ""))
    p = subprocess.Popen([str(path), query], stdout=subprocess.PIPE, env=env(), cwd=str(HOME))
    out = sys.stdout.buffer
    for raw in p.stdout:
        line = raw.decode("utf-8", "replace").rstrip("\n")
        try:
            item = json.loads(line)
        except ValueError:
            item = None
        if isinstance(item, dict):
            rewrite(item.get("action"))
            for extra in item.get("actions") or []:
                rewrite(extra)
            line = json.dumps(item, ensure_ascii=False)
        out.write(line.encode() + b"\n")
        out.flush()
    return p.wait()


WRAPPER = r"""@echo off
rem Runs the {plugin} plugin from ~/dotfiles/zunder/.config/zunder/plugins inside WSL ({distro}),
rem through ~/.local/bin/zunder-wsl. The query travels as ZQ via WSLENV, never through cmd parsing.
rem Generated by `zunder-wsl --sync`; edit the plugin, not this file.
{headers}set ZQ=%1
if defined WSLENV (set "WSLENV=ZQ/u:%WSLENV%") else (set "WSLENV=ZQ/u")
wsl.exe -d {distro} -e {self} {plugin}
"""


def windows_plugins_dir():
    r = subprocess.run(["/mnt/c/Windows/System32/cmd.exe", "/c", "echo %APPDATA%"], capture_output=True, stdin=subprocess.DEVNULL, cwd="/mnt/c")
    appdata = r.stdout.decode(errors="replace").strip()
    r = subprocess.run(["wslpath", "-u", appdata], capture_output=True)
    return Path(r.stdout.decode().strip()) / "zunder/plugins"


def headers(path):
    """The plugin's @zunder lines, glyphs as \\uXXXX so the .cmd stays ASCII."""
    out = []
    for line in path.read_text(errors="replace").splitlines()[:30]:
        m = re.search(r"@zunder\.(\w+)\s+(.*\S)", line)
        if m:
            value = "".join(c if ord(c) < 128 else f"\\u{ord(c):x}" for c in m.group(2))
            out.append(f"rem @zunder.{m.group(1):<6} {value}\n")
    return "".join(out)


def sync():
    target = windows_plugins_dir()
    target.mkdir(parents=True, exist_ok=True)
    plugins = sorted(p for p in PLUGINS.iterdir() if p.is_file() and os.access(p, os.X_OK))
    for p in plugins:
        text = WRAPPER.format(plugin=p.name, distro=DISTRO, self=SELF, headers=headers(p))
        (target / f"{p.name}.cmd").write_bytes(text.replace("\n", "\r\n").encode())
    names = {p.name for p in plugins}
    for old in target.glob("*.cmd"):
        if "zunder-wsl" in old.read_text(errors="replace") and old.stem not in names:
            old.unlink()
            print(f"removed {old.name}")
    print(f"{len(plugins)} plugins → {target}: " + ", ".join(sorted(names)))
    return 0


def main():
    if sys.argv[1:2] == ["--sync"]:
        sys.exit(sync())
    if sys.argv[1:2] == ["--run"] and len(sys.argv) == 3:
        cmd = base64.urlsafe_b64decode(sys.argv[2]).decode()
        os.chdir(HOME)
        # zunder throws an action's output away: keep the last runs in a log instead
        LOG.parent.mkdir(parents=True, exist_ok=True)
        if LOG.exists() and LOG.stat().st_size > 200_000:
            LOG.replace(LOG.with_suffix(".log.1"))
        fd = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        os.write(fd, f"--- {time.strftime('%F %T')} {cmd[:300]}\n".encode())
        os.dup2(fd, 1)
        os.dup2(fd, 2)
        os.execvpe("bash", ["bash", "-c", cmd], env())
    if len(sys.argv) == 2:
        sys.exit(run_plugin(sys.argv[1]))
    print("usage: zunder-wsl <plugin>  (query in $ZQ) | zunder-wsl --run <base64> | zunder-wsl --sync", file=sys.stderr)
    sys.exit(2)


main()
