#!/usr/bin/env python3
"""
secrets - sync machine-local credential files with Vaultwarden.

Vaultwarden is the source of truth. Every credential file listed in the
manifest is one Secure Note in the folder "Secrets/<group>": each value is a
hidden custom field, the note body is the file with the values replaced by
{{KEY}} placeholders (so comments and layout survive a round trip).

Scripts and agents keep reading their plain files (chmod 600) - nothing needs
an unlocked vault at runtime. `secrets pull` writes those files on a machine,
`secrets push` uploads a local file after you changed it.

    secrets status                 what this host should have, and whether it is in sync
    secrets pull [item...]         write the files for this host (or the named items)
    secrets push <item...>         upload the local file(s) to Vaultwarden
    secrets set <item> <KEY>       prompt for one value (hidden) and store it
    secrets list                   every manifest entry, all hosts

Options: --force (pull over a local file that is newer than the vault copy),
         --dry-run (pull/push: show what would change, write nothing),
         --sync (re-download the vault first; done automatically if the last
                 sync is older than 5 min - use it right after a web UI edit).

Unlock first:  set -gx BW_SESSION (bw unlock --raw)     (fish: `secrets-unlock`)

Shared values: fields of items in "Secrets/shared" (e.g. `ntfy`) can be
referenced as `ref:<item>/<KEY>`. `push` swaps any value that equals a shared
field for such a reference, so a rotated ntfy token is changed in one place.

Values are never printed. They reach `bw` on stdin, not on the command line.
"""
import argparse
import base64
import getpass
import json
import os
import re
import socket
import subprocess
import sys
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from pathlib import Path

MANIFEST = Path(os.environ.get("SECRETS_MANIFEST", "~/.config/secrets/manifest.tsv")).expanduser()
ROOT = "Secrets"
SHARED = "shared"
FORMATS = ("env", "fish", "raw")
MIN_REF_LEN = 8  # never turn short values like "465" into references
SYNC_STAMP = Path("~/.cache/secrets/last-sync").expanduser()
SYNC_MAX_AGE = 300  # seconds; older than this -> `bw sync` first (pass --sync to force)

ENV_RE = re.compile(r"^(\s*(?:export\s+)?)([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
FISH_RE = re.compile(r"^(\s*set\s+(?:-[A-Za-z]+\s+)*)([A-Za-z_][A-Za-z0-9_]*)\s+(.*)$")
PLACEHOLDER = re.compile(r"\{\{([A-Za-z_][A-Za-z0-9_]*)\}\}")


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def host():
    return os.environ.get("SECRETS_HOST") or socket.gethostname()


# --- manifest -----------------------------------------------------------------

def load_manifest():
    if not MANIFEST.exists():
        die(f"{MANIFEST} missing - stow the dotfiles `secrets` package")
    entries = {}
    for n, line in enumerate(MANIFEST.read_text().splitlines(), 1):
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        parts = line.split()
        if len(parts) != 5:
            die(f"{MANIFEST}:{n}: want 5 columns (item group format hosts path)")
        item, group, fmt, hosts, path = parts
        if fmt not in FORMATS:
            die(f"{MANIFEST}:{n}: format must be one of {', '.join(FORMATS)}")
        entries[item] = {"item": item, "group": group, "format": fmt,
                         "hosts": hosts.split(","), "path": Path(path).expanduser()}
    return entries


def for_this_host(entries):
    h = host()
    return [e for e in entries.values()
            if ("*" in e["hosts"] or h in e["hosts"]) and f"!{h}" not in e["hosts"]]


def pick(entries, names, default_all_host=True):
    if not names:
        return for_this_host(entries) if default_all_host else []
    unknown = [n for n in names if n not in entries]
    if unknown:
        die(f"not in manifest: {', '.join(unknown)}")
    return [entries[n] for n in names]


# --- file <-> template + values -------------------------------------------------

def split_value(raw):
    """Return (prefix, value, suffix) so prefix+value+suffix == raw."""
    s = raw.rstrip()
    trail = raw[len(s):]
    if len(s) >= 2 and s[0] in "\"'" and s[-1] == s[0]:
        return s[0], s[1:-1], s[-1] + trail
    m = re.search(r"\s+#", s)
    if m:  # unquoted value with an inline comment
        return "", s[:m.start()], s[m.start():] + trail
    return "", s, trail


def parse(text, fmt):
    if fmt == "raw":
        return "{{content}}", {"content": text}
    rx = ENV_RE if fmt == "env" else FISH_RE
    values, out = {}, []
    for line in text.split("\n"):
        m = rx.match(line)
        if not m or line.lstrip().startswith("#"):
            out.append(line)
            continue
        lead, key, rest = m.group(1), m.group(2), m.group(3)
        pre, val, post = split_value(rest)
        sep = "=" if fmt == "env" else line[m.end(2):m.start(3)]
        values[key] = val
        out.append(f"{lead}{key}{sep}{pre}{{{{{key}}}}}{post}")
    return "\n".join(out), values


def render(template, values):
    missing = [k for k in PLACEHOLDER.findall(template) if k not in values]
    if missing:
        die(f"template needs fields that are not stored: {', '.join(missing)}")
    return PLACEHOLDER.sub(lambda m: values[m.group(1)], template)


# --- bw -------------------------------------------------------------------------

class BW:
    """Every `bw` call costs ~1.5 s (Node start + decrypt), so the whole vault is
    read once - folders and items in parallel - and everything else is local."""

    def __init__(self, sync=False):
        if not os.environ.get("BW_SESSION"):
            die("vault locked - run: set -gx BW_SESSION (bw unlock --raw)   (fish: secrets-unlock)")
        if sync or self.sync_age() > SYNC_MAX_AGE:
            self.run("sync")
            self.mark_synced()
        with ThreadPoolExecutor(2) as pool:
            folders = pool.submit(self.json, "list", "folders")
            items = pool.submit(self.json, "list", "items")
            self._folders = {f["name"]: f["id"] for f in folders.result()}
            self._all = items.result()

    @staticmethod
    def sync_age():
        try:
            return time.time() - SYNC_STAMP.stat().st_mtime
        except FileNotFoundError:
            return float("inf")

    @staticmethod
    def mark_synced():
        SYNC_STAMP.parent.mkdir(parents=True, exist_ok=True)
        SYNC_STAMP.touch()

    def run(self, *args, stdin=None):
        try:
            p = subprocess.run(["bw", *args], input=stdin, capture_output=True, text=True)
        except FileNotFoundError:
            die("bw not found - install the Bitwarden CLI - see ~/dotfiles/docs/secrets.md (standalone 2026.7.0)")
        if p.returncode != 0:
            err = p.stderr.strip() or p.stdout.strip()
            if re.search(r"locked|not logged in|session", err, re.I):
                die("vault locked - run: set -gx BW_SESSION (bw unlock --raw)   (fish: secrets-unlock)")
            die(f"bw {args[0]} failed: {err}")
        return p.stdout

    def json(self, *args, stdin=None):
        out = self.run(*args, stdin=stdin)
        return json.loads(out) if out.strip() else {}

    @staticmethod
    def encode(obj):
        return base64.b64encode(json.dumps(obj).encode()).decode()

    def folder_id(self, group, create=False):
        name = f"{ROOT}/{group}"
        if name not in self._folders and create:
            if ROOT not in self._folders:
                self._folders[ROOT] = self.json("create", "folder", stdin=self.encode({"name": ROOT}))["id"]
            self._folders[name] = self.json("create", "folder", stdin=self.encode({"name": name}))["id"]
        return self._folders.get(name)

    def items_in(self, group):
        fid = self.folder_id(group)
        return [it for it in self._all if fid and it.get("folderId") == fid]

    def item(self, group, name):
        return next((it for it in self.items_in(group) if it.get("name") == name), None)

    def save(self, group, name, notes, values):
        fields = [{"name": k, "value": v, "type": 1, "linkedId": None} for k, v in values.items()]
        existing = self.item(group, name)
        if existing:
            existing["notes"], existing["fields"] = notes, fields
            saved = self.json("edit", "item", existing["id"], stdin=self.encode(existing))
        else:
            obj = {"type": 2, "name": name, "notes": notes, "fields": fields,
                   "folderId": self.folder_id(group, create=True), "organizationId": None,
                   "secureNote": {"type": 0}, "favorite": False, "reprompt": 0,
                   "login": None, "card": None, "identity": None}
            saved = self.json("create", "item", stdin=self.encode(obj))
        self._all = [it for it in self._all if it.get("id") != saved["id"]] + [saved]
        self.mark_synced()  # bw updates its local cache on create/edit
        return saved


def fields_of(item):
    return {f["name"]: f.get("value") or "" for f in (item or {}).get("fields") or []}


def resolve(bw, values):
    out = {}
    for k, v in values.items():
        if v.startswith("ref:"):
            ref_item, _, ref_key = v[4:].partition("/")
            shared = fields_of(bw.item(SHARED, ref_item))
            if ref_key not in shared:
                die(f"{k} points to {v}, which does not exist in {ROOT}/{SHARED}")
            v = shared[ref_key]
        out[k] = v
    return out


def to_refs(bw, values):
    """Replace values equal to a shared field with a ref: pointer."""
    lookup = {}
    for it in bw.items_in(SHARED):
        for k, v in fields_of(it).items():
            if len(v) >= MIN_REF_LEN:
                lookup.setdefault(v, f"ref:{it['name']}/{k}")
    swapped = [k for k, v in values.items() if v in lookup]
    return {k: lookup.get(v, v) for k, v in values.items()}, swapped


# --- local files ---------------------------------------------------------------

def write_private(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


def vault_time(item):
    return datetime.fromisoformat(item["revisionDate"].replace("Z", "+00:00"))


def local_time(path):
    return datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)


def state(bw, e):
    """-> (label, rendered vault text or None)"""
    it = bw.item(e["group"], e["item"])
    have = e["path"].exists()
    if not it:
        return ("not in vault" + (" - push it" if have else ""), None)
    text = render(it.get("notes") or "", resolve(bw, fields_of(it)))
    if not have:
        return ("missing locally - pull it", text)
    if e["path"].read_text() == text:
        return ("in sync", text)
    newer = "local newer - push?" if local_time(e["path"]) > vault_time(it) else "vault newer - pull"
    return (f"differs ({newer})", text)


# --- commands --------------------------------------------------------------------

def cmd_list(entries, args):
    for e in entries.values():
        print(f"{e['item']:22} {ROOT}/{e['group']:12} {e['format']:5} {','.join(e['hosts']):24} {e['path']}")


def cmd_status(entries, args):
    bw = BW(sync=args.sync)
    print(f"host {host()}")
    for e in pick(entries, args.items):
        label, _ = state(bw, e)
        mode = ""
        if e["path"].exists() and e["path"].stat().st_mode & 0o077:
            mode = "  [WARN readable by others - pull fixes it, or chmod 600]"
        print(f"  {e['item']:22} {label}{mode}")


def cmd_pull(entries, args):
    bw = BW(sync=args.sync)
    for e in pick(entries, args.items):
        label, text = state(bw, e)
        if text is None:
            print(f"  skip  {e['item']:22} {label}")
            continue
        if label == "in sync":
            os.chmod(e["path"], 0o600)
            print(f"  ok    {e['item']:22} in sync")
            continue
        if "local newer" in label and not args.force:
            print(f"  keep  {e['item']:22} local file is newer - push it, or pull --force")
            continue
        if args.dry_run:
            print(f"  would write {e['item']:16} -> {e['path']}")
            continue
        write_private(e["path"], text)
        print(f"  wrote {e['item']:22} -> {e['path']}")


def cmd_push(entries, args):
    if not args.items:
        die("name the item(s) to push - see `secrets status`")
    bw = BW(sync=args.sync)
    for e in pick(entries, args.items):
        if not e["path"].exists():
            die(f"{e['path']} does not exist on this host")
        template, values = parse(e["path"].read_text(), e["format"])
        values, swapped = to_refs(bw, values) if e["group"] != SHARED else (values, [])
        note = f"  (refs: {', '.join(swapped)})" if swapped else ""
        if args.dry_run:
            print(f"  would push {e['item']:17} {len(values)} fields{note}")
            continue
        bw.save(e["group"], e["item"], template, values)
        print(f"  push  {e['item']:22} {len(values)} fields -> {ROOT}/{e['group']}{note}")


def cmd_set(entries, args):
    if len(args.items) != 2:
        die("usage: secrets set <item> <KEY>")
    name, key = args.items
    if name in entries:
        die(f"{name} is a file item - edit {entries[name]['path']} and `secrets push {name}` instead")
    group = args.group or SHARED
    bw = BW(sync=args.sync)
    value = getpass.getpass(f"{name}/{key}: ")
    if not value:
        die("empty value, nothing stored")
    it = bw.item(group, name)
    values = fields_of(it)
    values[key] = value
    bw.save(group, name, (it or {}).get("notes") or "", values)
    print(f"  set   {name}/{key} in {ROOT}/{group}")


def main():
    ap = argparse.ArgumentParser(prog="secrets", description=__doc__.split("\n\n")[0])
    ap.add_argument("command", choices=["status", "pull", "push", "set", "list"])
    ap.add_argument("items", nargs="*")
    ap.add_argument("--force", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--sync", action="store_true", help="force `bw sync` (default: only if the last one is >5 min old)")
    ap.add_argument("--group", help="set: folder for an item that is not in the manifest (default: shared)")
    args = ap.parse_args()
    entries = load_manifest()
    {"status": cmd_status, "pull": cmd_pull, "push": cmd_push,
     "set": cmd_set, "list": cmd_list}[args.command](entries, args)


if __name__ == "__main__":
    main()
