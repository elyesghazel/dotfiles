#!/usr/bin/env python3
"""mailctl - read and send mail on the Mailu server (elyes@elyesghazel.ch, info@slideplate.ch).

  mailctl accounts
  mailctl list   [-a ACC] [-f FOLDER|--all-folders] [-n 20] [--unread] [--since 2h] [--from X] [--to X] [--subject X]
  mailctl read   UID [-a ACC] [-f FOLDER] [--raw]
  mailctl code   [-a ACC] [--since 15m] [--from X] [--wait 120]
  mailctl folders [-a ACC]
  mailctl send   -a ACC --to X [--cc X] [--bcc X] --subject S (--body TEXT | --body-file F)
                 [--attach F ...] [--reply UID [-f FOLDER]] [--draft] [--yes]

send without --yes only prints a preview. --draft saves to Drafts instead of sending.
Config: ~/.config/mailctl/accounts.env (Mailu app tokens). Sent log: ~/.local/state/mailctl/sent.log
"""
import argparse, email, email.policy, html, imaplib, mimetypes, os, re, smtplib, ssl, sys, time
from datetime import datetime, timedelta, timezone
from email.message import EmailMessage
from email.utils import formataddr, formatdate, make_msgid, parsedate_to_datetime, getaddresses
from html.parser import HTMLParser
from pathlib import Path

CONFIG = Path.home() / ".config/mailctl/accounts.env"
SENT_LOG = Path.home() / ".local/state/mailctl/sent.log"


def load_config():
    if not CONFIG.exists():
        sys.exit(f"missing {CONFIG} - run: secrets pull mailctl")
    cfg = {}
    for line in CONFIG.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        cfg[k.strip()] = v.strip().strip('"').strip("'")
    return cfg


def account(cfg, name):
    name = (name or cfg.get("DEFAULT_ACCOUNT", "elyes")).lower()
    names = [a.strip().lower() for a in cfg["ACCOUNTS"].split(",")]
    if name not in names:
        # allow passing the address itself
        for n in names:
            if cfg.get(f"{n.upper()}_USER", "").lower() == name:
                name = n
                break
        else:
            sys.exit(f"unknown account {name!r}; have: {', '.join(names)}")
    p = name.upper()
    return {
        "name": name,
        "user": cfg[f"{p}_USER"],
        "password": cfg[f"{p}_PASSWORD"],
        "from_name": cfg.get(f"{p}_FROM_NAME", ""),
        "host": cfg.get("MAIL_HOST", "mail.elyesghazel.ch"),
        "imap_port": int(cfg.get("IMAP_PORT", 993)),
        "smtp_port": int(cfg.get("SMTP_PORT", 465)),
    }


def imap(acc):
    m = imaplib.IMAP4_SSL(acc["host"], acc["imap_port"], ssl_context=ssl.create_default_context())
    m.login(acc["user"], acc["password"])
    return m


def q(folder):
    return '"' + folder.replace("\\", "\\\\").replace('"', '\\"') + '"'


def list_folders(m):
    typ, data = m.list()
    out = []
    for raw in data or []:
        line = raw.decode(errors="replace")
        mt = re.match(r'\((?P<flags>[^)]*)\) "(?P<d>[^"]*)" (?P<name>.+)$', line)
        if not mt:
            continue
        name = mt["name"].strip()
        if name.startswith('"'):
            name = name[1:-1].replace('\\"', '"')
        out.append((name, mt["flags"]))
    return out


def special_folder(m, flag, fallbacks):
    folders = list_folders(m)
    for name, flags in folders:
        if flag.lower() in flags.lower():
            return name
    names = [n for n, _ in folders]
    for f in fallbacks:
        if f in names:
            return f
    return fallbacks[0]


def parse_since(s):
    mt = re.fullmatch(r"(\d+)\s*([mhdw])", s.strip())
    if not mt:
        sys.exit(f"bad --since {s!r}, use e.g. 15m, 2h, 3d, 1w")
    n, u = int(mt[1]), mt[2]
    unit = {"m": "minutes", "h": "hours", "d": "days", "w": "weeks"}[u]
    return datetime.now(timezone.utc) - timedelta(**{unit: n})


def dhdr(v):
    if v is None:
        return ""
    return str(email.header.make_header(email.header.decode_header(str(v)))) if not isinstance(v, str) else v


class _Text(HTMLParser):
    BLOCK = {"p", "div", "br", "tr", "li", "h1", "h2", "h3", "h4", "table", "section"}

    def __init__(self):
        super().__init__()
        self.out, self.skip = [], 0

    def handle_starttag(self, tag, attrs):
        if tag in ("style", "script", "head"):
            self.skip += 1
        if tag in self.BLOCK:
            self.out.append("\n")
        if tag == "a":
            href = dict(attrs).get("href")
            if href and href.startswith("http"):
                self._href = href

    def handle_endtag(self, tag):
        if tag in ("style", "script", "head"):
            self.skip = max(0, self.skip - 1)
        if tag == "a" and getattr(self, "_href", None):
            self.out.append(f" <{self._href}>")
            self._href = None

    def handle_data(self, d):
        if not self.skip:
            self.out.append(d)


def html_to_text(s):
    p = _Text()
    p.feed(s)
    t = html.unescape("".join(p.out))
    t = re.sub(r"[ \t ]+", " ", t)
    t = re.sub(r"\n\s*\n+", "\n\n", t)
    return t.strip()


def body_text(msg, both=False):
    plain = htmlb = None
    for part in msg.walk():
        if part.get_content_maintype() == "multipart" or part.get_filename():
            continue
        ct = part.get_content_type()
        try:
            content = part.get_content()
        except Exception:
            content = (part.get_payload(decode=True) or b"").decode("utf-8", "replace")
        if ct == "text/plain" and plain is None:
            plain = content
        elif ct == "text/html" and htmlb is None:
            htmlb = content
    if both:
        return "\n\n".join(filter(None, [plain, htmlb and html_to_text(htmlb)]))
    # some senders put a placeholder in text/plain (IKEA: "TEXT_FORMAT_BODY")
    if plain and len(plain.strip()) > 40:
        return plain.strip()
    if htmlb:
        return html_to_text(htmlb)
    return ""


def attachments(msg):
    return [(p.get_filename(), p.get_content_type(), len(p.get_payload(decode=True) or b""))
            for p in msg.walk() if p.get_filename()]


def search_criteria(args):
    crit = []
    if getattr(args, "unread", False):
        crit.append("UNSEEN")
    if getattr(args, "since", None):
        crit += ["SINCE", parse_since(args.since).strftime("%d-%b-%Y")]
    for key, flag in (("from_", "FROM"), ("to", "TO"), ("subject", "SUBJECT")):
        v = getattr(args, key, None)
        if v:
            crit += [flag, q(v)]
    return crit or ["ALL"]


def fetch_headers(m, folder, crit, limit, since_dt=None):
    typ, _ = m.select(q(folder), readonly=True)
    if typ != "OK":
        return []
    typ, data = m.uid("SEARCH", None, *crit)
    uids = data[0].split() if data and data[0] else []
    uids = uids[-limit:] if limit else uids
    rows = []
    if not uids:
        return rows
    typ, data = m.uid("FETCH", b",".join(uids),
                      "(FLAGS INTERNALDATE BODY.PEEK[HEADER.FIELDS (FROM TO DELIVERED-TO SUBJECT DATE)])")
    for item in data:
        if not isinstance(item, tuple):
            continue
        meta = item[0].decode()
        uid = re.search(r"UID (\d+)", meta)[1]
        seen = "\\Seen" in meta
        idate = imaplib.Internaldate2tuple(item[0])
        dt = datetime.fromtimestamp(time.mktime(idate), timezone.utc) if idate else None
        if since_dt and dt and dt < since_dt:
            continue
        h = email.message_from_bytes(item[1], policy=email.policy.default)
        rows.append({"folder": folder, "uid": uid, "seen": seen, "date": dt,
                     "from": dhdr(h["From"]), "to": dhdr(h["Delivered-To"] or h["To"]),
                     "subject": dhdr(h["Subject"])})
    return rows


def all_mail_folders(m):
    skip = re.compile(r"^(Junk|Trash|Spam|Drafts|Sent)", re.I)
    return [n for n, f in list_folders(m) if not skip.match(n) and "\\Noselect" not in f]


def cmd_accounts(cfg, args):
    for n in cfg["ACCOUNTS"].split(","):
        a = account(cfg, n.strip())
        print(f"{a['name']:<12} {a['user']:<28} {a['from_name']}")


def cmd_folders(cfg, args):
    m = imap(account(cfg, args.account))
    for name, flags in list_folders(m):
        print(f"{name:<30} {flags}")
    m.logout()


def cmd_list(cfg, args):
    m = imap(account(cfg, args.account))
    folders = all_mail_folders(m) if args.all_folders else [args.folder]
    since_dt = parse_since(args.since) if args.since else None
    rows = []
    for f in folders:
        rows += fetch_headers(m, f, search_criteria(args), args.n, since_dt)
    m.logout()
    rows.sort(key=lambda r: r["date"] or datetime.min.replace(tzinfo=timezone.utc))
    for r in rows[-args.n:]:
        d = r["date"].astimezone().strftime("%m-%d %H:%M") if r["date"] else "?"
        star = " " if r["seen"] else "*"
        loc = f"{r['folder']}:{r['uid']}" if args.all_folders else r["uid"]
        print(f"{star}{loc:>8}  {d}  {r['from'][:38]:<38}  {r['subject'][:80]}"
              + (f"  [to {r['to']}]" if args.show_to else ""))


def get_message(m, folder, uid):
    typ, _ = m.select(q(folder), readonly=True)
    if typ != "OK":
        sys.exit(f"no folder {folder!r}")
    typ, data = m.uid("FETCH", str(uid), "(BODY.PEEK[])")
    for item in data or []:
        if isinstance(item, tuple):
            return email.message_from_bytes(item[1], policy=email.policy.default)
    sys.exit(f"no message UID {uid} in {folder}")


def split_loc(uid, folder):
    if ":" in str(uid):
        folder, uid = str(uid).rsplit(":", 1)
    return folder, uid


def cmd_read(cfg, args):
    m = imap(account(cfg, args.account))
    folder, uid = split_loc(args.uid, args.folder)
    msg = get_message(m, folder, uid)
    m.logout()
    if args.raw:
        sys.stdout.write(msg.as_string())
        return
    for h in ("From", "To", "Cc", "Delivered-To", "Date", "Subject", "Message-ID"):
        if msg[h]:
            print(f"{h}: {dhdr(msg[h])}")
    att = attachments(msg)
    if att:
        print("Attachments: " + ", ".join(f"{n} ({t}, {s // 1024} KB)" for n, t, s in att))
    print()
    print(body_text(msg))


KEYWORD_RE = re.compile(
    r"(?i)(?:code|pin|otp|passcode|verification|verify|bestätigung\w*|sicherheitscode|einmal\w*|codice|token)"
    r"[^\n\d]{0,60}?\b(\d{3}[ -]\d{3}|[A-Z0-9]{4,10})\b")
LINE_RE = re.compile(r"(?m)^\s*(\d{3}[ -]?\d{3}|[A-Z0-9]{4,8})\s*$")
URL_RE = re.compile(r"https?://[^\s<>\"')]+")
LINK_KW = re.compile(r"verify|confirm|magic|login|signin|sign-in|token|auth", re.I)


def find_link(text):
    """first URL whose path (not query - tracking params say 'magic_link' too) looks like a login link"""
    from urllib.parse import urlsplit
    for u in URL_RE.findall(text or ""):
        u = u.rstrip(".,;")
        if LINK_KW.search(urlsplit(u).path):
            return u
    return None


def _ok(c):
    return any(ch.isdigit() for ch in c) and not re.fullmatch(r"(19|20)\d\d", c)


def find_code(subject, text):
    """keyword-anchored code first, then a code alone on its own line, then a 6-digit in the subject"""
    for blob in (subject, text):
        for mt in KEYWORD_RE.finditer(blob or ""):
            if _ok(mt[1]):
                return re.sub(r"[ -]", "", mt[1])
    for mt in LINE_RE.finditer(text or ""):
        if _ok(mt[1]):
            return re.sub(r"[ -]", "", mt[1])
    mt = re.search(r"\b(\d{6})\b", subject or "")
    return mt[1] if mt else None


def cmd_code(cfg, args):
    acc = account(cfg, args.account)
    deadline = time.time() + args.wait
    since_dt = parse_since(args.since)
    while True:
        m = imap(acc)
        rows = []
        crit = ["SINCE", since_dt.strftime("%d-%b-%Y")]
        if args.from_:
            crit += ["FROM", q(args.from_)]
        for f in all_mail_folders(m):
            rows += fetch_headers(m, f, crit, 30, since_dt)
        rows.sort(key=lambda r: r["date"], reverse=True)
        for r in rows:
            msg = get_message(m, r["folder"], r["uid"])
            text = body_text(msg, both=True)
            code = find_code(r["subject"], text)
            link = find_link(text)
            if code or link:
                print(code or link)
                print(f"  from {r['from']}  ·  {r['subject']}  ·  "
                      f"{r['date'].astimezone().strftime('%H:%M')}  ·  {r['folder']}:{r['uid']}", file=sys.stderr)
                if code and link:
                    print(f"  link: {link}", file=sys.stderr)
                m.logout()
                return
        m.logout()
        if time.time() >= deadline:
            sys.exit(f"no code found in the last {args.since}")
        time.sleep(5)


def build_message(acc, args, m=None):
    msg = EmailMessage()
    msg["From"] = formataddr((acc["from_name"], acc["user"])) if acc["from_name"] else acc["user"]
    msg["To"] = args.to
    if args.cc:
        msg["Cc"] = args.cc
    subject = args.subject
    if args.reply:
        folder, uid = split_loc(args.reply, args.folder)
        orig = get_message(m, folder, uid)
        mid = orig["Message-ID"]
        if mid:
            msg["In-Reply-To"] = mid
            msg["References"] = " ".join(filter(None, [orig.get("References", ""), mid])).strip()
        if not subject:
            s = dhdr(orig["Subject"])
            subject = s if re.match(r"(?i)^(re|aw):", s) else f"Re: {s}"
        if not args.to:
            msg.replace_header("To", orig["Reply-To"] or orig["From"])
    msg["Subject"] = subject or ""
    msg["Date"] = formatdate(localtime=True)
    msg["Message-ID"] = make_msgid(domain=acc["user"].split("@")[1])
    body = args.body if args.body is not None else Path(args.body_file).read_text() if args.body_file else ""
    msg.set_content(body)
    for f in args.attach or []:
        p = Path(f)
        ct, _ = mimetypes.guess_type(p.name)
        mt, st = (ct or "application/octet-stream").split("/", 1)
        msg.add_attachment(p.read_bytes(), maintype=mt, subtype=st, filename=p.name)
    return msg


def cmd_send(cfg, args):
    acc = account(cfg, args.account)
    if not args.to and not args.reply:
        sys.exit("--to is required (or --reply UID)")
    if args.body is None and not args.body_file:
        sys.exit("--body or --body-file is required")
    m = imap(acc)
    msg = build_message(acc, args, m)
    fields = [str(v) for v in (msg["To"], msg["Cc"], args.bcc) if v]
    rcpts = [a for _, a in getaddresses(fields) if a]
    if not rcpts:
        sys.exit("no recipients")

    if args.draft:
        drafts = special_folder(m, "\\Drafts", ["Drafts"])
        m.append(q(drafts), "(\\Draft)", imaplib.Time2Internaldate(time.time()), msg.as_bytes())
        m.logout()
        print(f"saved to {drafts} of {acc['user']}: {msg['Subject']} -> {', '.join(rcpts)}")
        return

    if not args.yes:
        m.logout()
        print("=== PREVIEW (not sent, re-run with --yes) ===")
        for h in ("From", "To", "Cc", "Subject", "In-Reply-To"):
            if msg[h]:
                print(f"{h}: {msg[h]}")
        if args.bcc:
            print(f"Bcc: {args.bcc}")
        for f in args.attach or []:
            print(f"Attach: {f} ({Path(f).stat().st_size // 1024} KB)")
        print()
        print(msg.get_body(("plain",)).get_content())
        return

    ctx = ssl.create_default_context()
    if acc["smtp_port"] == 587:  # 465 is intercepted on the home network, 587+STARTTLS works there
        s = smtplib.SMTP(acc["host"], 587)
        s.starttls(context=ctx)
    else:
        s = smtplib.SMTP_SSL(acc["host"], acc["smtp_port"], context=ctx)
    with s:
        s.login(acc["user"], acc["password"])
        s.send_message(msg, from_addr=acc["user"], to_addrs=rcpts)
    sent = special_folder(m, "\\Sent", ["Sent"])
    m.append(q(sent), "(\\Seen)", imaplib.Time2Internaldate(time.time()), msg.as_bytes())
    m.logout()
    SENT_LOG.parent.mkdir(parents=True, exist_ok=True)
    with SENT_LOG.open("a") as f:
        f.write(f"{datetime.now().isoformat(timespec='seconds')}\t{acc['user']}\t{', '.join(rcpts)}\t{msg['Subject']}\n")
    print(f"sent from {acc['user']} to {', '.join(rcpts)}: {msg['Subject']}")


def main():
    ap = argparse.ArgumentParser(prog="mailctl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)

    def common(p, folder=True):
        p.add_argument("-a", "--account")
        if folder:
            p.add_argument("-f", "--folder", default="INBOX")

    sub.add_parser("accounts")
    common(sub.add_parser("folders"), folder=False)

    p = sub.add_parser("list")
    common(p)
    p.add_argument("-n", type=int, default=20)
    p.add_argument("--all-folders", action="store_true", help="INBOX + subfolders, not Junk/Trash/Sent/Drafts")
    p.add_argument("--unread", action="store_true")
    p.add_argument("--since")
    p.add_argument("--from", dest="from_")
    p.add_argument("--to", help="matches To; catch-all aliases also show in Delivered-To")
    p.add_argument("--subject")
    p.add_argument("--show-to", action="store_true")

    p = sub.add_parser("read")
    common(p)
    p.add_argument("uid", help="UID or FOLDER:UID")
    p.add_argument("--raw", action="store_true")

    p = sub.add_parser("code", help="print the newest 2FA/verification code")
    common(p, folder=False)
    p.add_argument("--since", default="15m")
    p.add_argument("--from", dest="from_")
    p.add_argument("--wait", type=int, default=0, help="poll up to N seconds for the mail to arrive")

    p = sub.add_parser("send")
    common(p)
    p.add_argument("--to")
    p.add_argument("--cc")
    p.add_argument("--bcc")
    p.add_argument("--subject")
    p.add_argument("--body")
    p.add_argument("--body-file")
    p.add_argument("--attach", action="append")
    p.add_argument("--reply", help="UID or FOLDER:UID to reply to (threads it, fills Re: subject)")
    p.add_argument("--draft", action="store_true", help="save to Drafts instead of sending")
    p.add_argument("--yes", action="store_true", help="actually send (only after Elyes approved the preview)")

    args = ap.parse_args()
    cfg = load_config()
    {"accounts": cmd_accounts, "folders": cmd_folders, "list": cmd_list, "read": cmd_read,
     "code": cmd_code, "send": cmd_send}[args.cmd](cfg, args)


if __name__ == "__main__":
    import email.header  # noqa: F401
    main()
