# Copy to ~/.claude/secrets.fish and fill in. That file is gitignored.
# Consumed by ~/.claude/bin/mcp-bootstrap.fish.

# Self-hosted Excalidraw MCP bridge (tailnet address, not internet-exposed)
set -gx EXCALIDRAW_MCP_URL  "http://<tailscale-ip>:8571/mcp"
set -gx EXCALIDRAW_MCP_TOKEN "<bearer-token>"

# Sumry finances. The MCP server mints its own JWT from these, so the login
# password is stored rather than a token that expires after 30 days.
set -gx SUMRY_API_URL  "https://sumry-api.elyesghazel.ch"
set -gx SUMRY_EMAIL    "<sumry-login-email>"
set -gx SUMRY_PASSWORD "<sumry-password>"

# Self-hosted ntfy, used by the `clip` fish function (text -> phone).
# Topic is private (deny-all server); make a token with `ntfy token add <user>`.
set -gx NTFY_URL   "https://ntfy.elyesghazel.ch"
set -gx NTFY_TOPIC "<topic>"
set -gx NTFY_TOKEN "<tk_...>"
