{
  "model": "opus",
  "statusLine": {
    "type": "command",
    "command": "codecash render # codecash-statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "shortcuts-playground@shortcuts-playground": true,
    "marketing@synced": false
  },
  "extraKnownMarketplaces": {
    "claude-hud": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-hud"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "shortcuts-playground": {
      "source": {
        "source": "git",
        "url": "https://github.com/viticci/shortcuts-playground-plugin.git"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark",
  "switchModelsOnFlag": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
